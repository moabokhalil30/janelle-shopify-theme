{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- assign nav_flatten = section.settings.nav_flatten_item | strip | downcase -%}
    {%- for link in section.settings.menu.links -%}
      {%- assign nav_title = link.title | strip | downcase -%}
      {%- if nav_flatten != blank and nav_title == nav_flatten -%}
        {%- for topic in link.links -%}
          {% render 'janelle-nav-item', link: topic, mode: 'bar', scheme: section.settings.menu_color_scheme %}
        {%- endfor -%}
        {%- if section.settings.nav_extra_label != blank -%}
          {% render 'janelle-nav-item', title: section.settings.nav_extra_label, url: section.settings.nav_extra_link, mode: 'bar', scheme: section.settings.menu_color_scheme %}
        {%- endif -%}
      {%- else -%}
        {% render 'janelle-nav-item', link: link, mode: 'bar', scheme: section.settings.menu_color_scheme %}
      {%- endif -%}
    {%- endfor -%}
  </ul>
</nav>
