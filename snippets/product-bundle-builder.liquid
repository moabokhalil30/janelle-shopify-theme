{%- liquid
  assign builder_id = 'bundle-picker-' | append: section.id | append: '-' | append: block.id
  assign source_1_setting = block.settings.source_product_1
  assign source_2_setting = block.settings.source_product_2
  assign source_3_setting = block.settings.source_product_3
  assign source_1_handle = source_1_setting.handle | default: source_1_setting
  assign source_2_handle = source_2_setting.handle | default: source_2_setting
  assign source_3_handle = source_3_setting.handle | default: source_3_setting
  assign source_1 = source_1_setting
  assign source_2 = source_2_setting
  assign source_3 = source_3_setting

  if source_1.variants.size == blank and source_1_handle != blank
    assign source_1 = all_products[source_1_handle]
  endif
  if source_1.variants.size == blank and block.settings.source_handle_1 != blank
    assign source_1 = all_products[block.settings.source_handle_1]
  endif
  if source_2.variants.size == blank and source_2_handle != blank
    assign source_2 = all_products[source_2_handle]
  endif
  if source_2.variants.size == blank and block.settings.source_handle_2 != blank
    assign source_2 = all_products[block.settings.source_handle_2]
  endif
  if source_3.variants.size == blank and source_3_handle != blank
    assign source_3 = all_products[source_3_handle]
  endif
  if source_3.variants.size == blank and block.settings.source_handle_3 != blank
    assign source_3 = all_products[block.settings.source_handle_3]
  endif

  assign cart_mode = block.settings.cart_mode | default: 'bundle_product'
  assign bundle_variant = product.selected_or_first_available_variant

  # Scoped to exactly these templates — every other template using this
  # shared snippet (Default, builder-4, liner-test, etc.) keeps the original
  # showShadeGallery/setHeroImage JS behavior further down, untouched.
  assign use_native_gallery_sync = false
  if template.suffix == 'builder' or template.suffix == 'builder-2' or template.suffix == 'builder-3'
    assign use_native_gallery_sync = true
  endif
-%}

<div
  class="janelle-bundle-picker"
  id="{{ builder_id }}"
  data-janelle-bundle-picker
  data-cart-mode="{{ cart_mode }}"
  data-bundle-variant-id="{{ bundle_variant.id }}"
  {{ block.shopify_attributes }}
>
  <div class="janelle-bundle-picker__head">
    <div>
      <p>{{ block.settings.eyebrow }}</p>
      <h2>{{ block.settings.heading }}</h2>
    </div>
    <span data-bundle-progress>0/3</span>
  </div>

  <div class="janelle-bundle-picker__selected" aria-live="polite">
    {%- for index in (1..3) -%}
      {%- liquid
        assign source_product = source_1
        assign slot_label = block.settings.label_1
        if index == 2
          assign source_product = source_2
          assign slot_label = block.settings.label_2
        elsif index == 3
          assign source_product = source_3
          assign slot_label = block.settings.label_3
        endif

        assign source_title = source_product.title
      -%}
      <div class="janelle-bundle-picker__slot" data-selected-slot="{{ index }}">
        <span class="janelle-bundle-picker__check" aria-hidden="true">✓</span>
        <div class="janelle-bundle-picker__slot-media" data-selected-media>
          <span>{{ index }}</span>
        </div>
        <div>
          <span>{{ slot_label }}</span>
          {%- if source_title != blank and source_title != slot_label -%}
            <small>{{ source_title }}</small>
          {%- endif -%}
          <strong data-selected-title>{{ block.settings.empty_text }}</strong>
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="janelle-bundle-picker__groups">
    {%- for index in (1..3) -%}
      {%- liquid
        assign source_product = source_1
        assign slot_label = block.settings.label_1
        if index == 2
          assign source_product = source_2
          assign slot_label = block.settings.label_2
        elsif index == 3
          assign source_product = source_3
          assign slot_label = block.settings.label_3
        endif
      -%}
      {%- comment -%}
        Ordered list of the source product's image media. The JS uses this to
        derive each shade's image "run" (from a variant's main photo up to the
        next variant's main photo) — mirroring how the single product page
        groups a shade's photos.
      {%- endcomment -%}
      {%- assign jb_img_i = 0 -%}
      {%- capture source_media_json -%}[{%- for m in source_product.media -%}{%- if m.media_type == 'image' -%}{%- if jb_img_i > 0 -%},{%- endif -%}"{{ m.preview_image | image_url: width: 1200 }}"{%- assign jb_img_i = jb_img_i | plus: 1 -%}{%- endif -%}{%- endfor -%}]{%- endcapture -%}
      <fieldset class="janelle-bundle-picker__group" data-bundle-group="{{ index }}" data-source-media="{{ source_media_json | escape }}">
        <legend>
          <span class="janelle-bundle-picker__legend-main">
            <span class="janelle-bundle-picker__step">Step {{ index }}</span>
            <strong>{{ slot_label }}</strong>
          </span>
          {%- if source_product.title != blank and source_product.title != slot_label -%}
            <em>{{ source_product.title }}</em>
          {%- endif -%}
        </legend>

        {%- if source_product != blank and source_product.variants.size > 0 -%}
          <div class="janelle-bundle-picker__rail">
            <button
              class="janelle-bundle-picker__scroll janelle-bundle-picker__scroll--prev"
              type="button"
              data-scroll-row
              data-direction="-1"
              aria-label="Previous shades"
            >
              ‹
            </button>
            <div class="janelle-bundle-picker__options" data-options-row>
            {%- for variant in source_product.variants -%}
                {%- liquid
                  assign variant_title = variant.title
                  if variant_title == 'Default Title'
                    assign variant_title = source_product.title
                  endif

                  assign variant_image = variant.featured_media.preview_image
                  if variant_image == blank
                    assign variant_image = variant.featured_image
                  endif

                  if variant_image == blank
                    assign variant_key = variant_title | handleize
                    for media in source_product.media
                      assign media_alt = media.alt | handleize
                      if media.media_type == 'image' and media_alt != blank
                        if media_alt == variant_key or media_alt contains variant_key or variant_key contains media_alt
                          assign variant_image = media.preview_image
                          break
                        endif
                      endif
                    endfor
                  endif

                  if variant_image == blank
                    assign source_image_count = source_product.media | where: 'media_type', 'image' | size
                    assign target_image_position = forloop.index
                    if source_image_count > source_product.variants.size
                      assign target_image_position = target_image_position | plus: 1
                    endif
                    assign image_media_position = 0
                    for media in source_product.media
                      if media.media_type == 'image'
                        assign image_media_position = image_media_position | plus: 1
                        if image_media_position == target_image_position
                          assign variant_image = media.preview_image
                          break
                        endif
                      endif
                    endfor
                  endif

                  if variant_image == blank
                    assign variant_image = source_product.featured_image
                  endif
                -%}
              <button
                class="janelle-bundle-picker__option"
                type="button"
                data-bundle-option
                data-slot="{{ index }}"
                data-variant-id="{{ variant.id }}"
                data-product-title="{{ source_product.title | escape }}"
                data-variant-title="{{ variant_title | escape }}"
                data-image="{% if variant_image %}{{ variant_image | image_url: width: 900 }}{% endif %}"
                aria-pressed="false"
                {% unless variant.available %}disabled{% endunless %}
              >
                <span class="janelle-bundle-picker__image">
                  {%- if variant_image -%}
                    {{
                      variant_image
                      | image_url: width: 180
                      | image_tag: loading: 'lazy', widths: '90, 140, 180', alt: variant_title
                    }}
                  {%- else -%}
                    <span>{{ variant_title | slice: 0, 1 }}</span>
                  {%- endif -%}
                </span>
                <span class="janelle-bundle-picker__name">{{ variant_title }}</span>
              </button>
            {%- endfor -%}
            </div>
            <button
              class="janelle-bundle-picker__scroll janelle-bundle-picker__scroll--next"
              type="button"
              data-scroll-row
              data-direction="1"
              aria-label="Next shades"
            >
              ›
            </button>
          </div>
        {%- else -%}
          <p class="janelle-bundle-picker__missing">Source product missing: {{ slot_label }}</p>
        {%- endif -%}
      </fieldset>
    {%- endfor -%}
  </div>

  <button class="product-form__submit button button--full-width button--primary" type="button" data-add-bundle disabled>
    <span>{{ block.settings.button_label }}</span>
    {%- render 'loading-spinner' -%}
  </button>
  <p class="janelle-bundle-picker__status" data-bundle-status>{{ block.settings.incomplete_text }}</p>
</div>

<style>
  .janelle-bundle-picker {
    --jb-ink: #3c2633;
    --jb-muted: #7b6572;
    --jb-accent: #b9648a;
    --jb-line: #ead7e2;
    --jb-soft: #fff7fa;
    --jb-surface: #ffffff;
    margin: 2rem 0;
    max-width: none;
    padding: 1.4rem;
    border: 0.1rem solid var(--jb-line);
    border-radius: 0.8rem;
    background: linear-gradient(180deg, var(--jb-surface), var(--jb-soft));
    box-shadow: 0 1rem 3rem rgba(60, 38, 51, 0.08);
  }

  .janelle-bundle-picker__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .janelle-bundle-picker__head p {
    margin: 0 0 0.3rem;
    color: var(--jb-accent);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.12rem;
    text-transform: uppercase;
  }

  .janelle-bundle-picker__head h2 {
    margin: 0;
    color: var(--jb-ink);
    font-size: 2rem;
    line-height: 1.15;
  }

  .janelle-bundle-picker__head span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.4rem;
    height: 3rem;
    border: 0.1rem solid var(--jb-line);
    border-radius: 999px;
    background: var(--jb-surface);
    color: var(--jb-accent);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .janelle-bundle-picker__selected {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin-bottom: 1.4rem;
  }

  .janelle-bundle-picker__slot {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.9rem 0.7rem;
    border: 0.1rem solid var(--jb-line);
    border-radius: 0.8rem;
    background: #fdeef5;
    text-align: center;
    transition: background var(--duration-short) ease, border-color var(--duration-short) ease, box-shadow var(--duration-short) ease;
  }

  /* Selected slot stays in the pink family (no white swap): deeper blush fill +
     accent border + glow ring, reinforced by the ✓ check badge below. */
  .janelle-bundle-picker__slot.is-selected {
    border-color: var(--jb-accent);
    background: #f6cfe1;
    box-shadow: 0 0 0 0.2rem rgba(185, 100, 138, 0.22), 0 0.6rem 1.8rem rgba(60, 38, 51, 0.08);
  }

  .janelle-bundle-picker__check {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: none;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--jb-accent);
    color: #fff;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 0.2rem 0.6rem rgba(60, 38, 51, 0.18);
  }

  .janelle-bundle-picker__slot.is-selected .janelle-bundle-picker__check {
    display: flex;
  }

  /* Keep the picked shade's photo on white so it reads cleanly on the deep fill. */
  .janelle-bundle-picker__slot.is-selected .janelle-bundle-picker__slot-media {
    background: #fff;
    border-color: var(--jb-accent);
  }

  .janelle-bundle-picker__slot.is-selected strong {
    color: var(--jb-accent);
  }

  .janelle-bundle-picker__slot-media {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
    max-width: 5.6rem;
    aspect-ratio: 1 / 1;
    border: 0.1rem solid var(--jb-line);
    border-radius: 0.6rem;
    background: var(--jb-soft);
    color: var(--jb-accent);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .janelle-bundle-picker__slot-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .janelle-bundle-picker__slot span {
    display: block;
    color: var(--jb-muted);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
  }

  .janelle-bundle-picker__slot strong {
    display: block;
    margin-top: 0.25rem;
    color: var(--jb-ink);
    font-size: 1.15rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .janelle-bundle-picker__slot small {
    display: block;
    margin-top: 0.2rem;
    color: var(--jb-muted);
    font-size: 1.05rem;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .janelle-bundle-picker__groups {
    display: grid;
    gap: 1rem;
  }

  .janelle-bundle-picker__group {
    /* min-width:0 is essential: a <fieldset> defaults to min-width:min-content,
       which would let the swatch rail expand to full content width and overflow
       the page instead of scrolling internally. */
    min-width: 0;
    margin: 0;
    padding: 1rem;
    border: 0.1rem solid var(--jb-line);
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.72);
  }

  .janelle-bundle-picker__group legend {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.7rem;
    width: calc(100% - 0.6rem);
    padding: 0 0.3rem;
    color: var(--jb-ink);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .janelle-bundle-picker__legend-main {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }

  .janelle-bundle-picker__step {
    color: var(--jb-accent);
    font-size: 1rem;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
  }

  .janelle-bundle-picker__group legend em {
    max-width: 14rem;
    color: var(--jb-muted);
    font-size: 1.05rem;
    font-style: normal;
    font-weight: 600;
    line-height: 1.2;
    text-align: right;
  }

  /* Swatches are a horizontal slider on every breakpoint. Arrows flank the
     rail (so they never overlap swatches) on desktop; mobile relies on swipe.
     Keeps the section short instead of a tall wrapping grid. */
  .janelle-bundle-picker__rail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    margin-top: 0.9rem;
  }

  .janelle-bundle-picker__options {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding: 0.3rem 0.2rem 1rem;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    /* Keep horizontal swipes inside the rail — never chain to the page. */
    overscroll-behavior: contain;
    touch-action: pan-x pan-y;
    scrollbar-width: thin;
    scrollbar-color: rgba(185, 100, 138, 0.5) transparent;
  }

  /* Arrows only appear when the rail actually overflows (set by JS). */
  .janelle-bundle-picker__rail:not([data-scrollable]) .janelle-bundle-picker__scroll {
    display: none;
  }

  .janelle-bundle-picker__rail:not([data-scrollable]) .janelle-bundle-picker__options {
    justify-content: center;
  }

  .janelle-bundle-picker__scroll[disabled] {
    cursor: default;
    opacity: 0.3;
  }

  .janelle-bundle-picker__options::-webkit-scrollbar {
    height: 0.5rem;
  }

  .janelle-bundle-picker__options::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: rgba(185, 100, 138, 0.35);
  }

  .janelle-bundle-picker__scroll {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 0.1rem solid var(--jb-line);
    border-radius: 999px;
    background: var(--jb-surface);
    color: var(--jb-accent);
    cursor: pointer;
    font-size: 2rem;
    line-height: 1;
    transition: border-color var(--duration-short) ease, box-shadow var(--duration-short) ease;
  }

  .janelle-bundle-picker__scroll:hover {
    border-color: rgba(185, 100, 138, 0.5);
    box-shadow: 0 0.4rem 1.2rem rgba(60, 38, 51, 0.08);
  }

  .janelle-bundle-picker__option {
    display: grid;
    gap: 0.6rem;
    flex: 0 0 9rem;
    min-width: 0;
    padding: 0.7rem;
    border: 0.1rem solid var(--jb-line);
    border-radius: 0.7rem;
    background: var(--jb-surface);
    color: var(--jb-ink);
    cursor: pointer;
    scroll-snap-align: start;
    text-align: left;
    transition: border-color var(--duration-short) ease, box-shadow var(--duration-short) ease, transform var(--duration-short) ease;
  }

  .janelle-bundle-picker__option:hover {
    border-color: rgba(185, 100, 138, 0.42);
    transform: translateY(-0.1rem);
  }

  .janelle-bundle-picker__option[aria-pressed='true'] {
    border-color: var(--jb-accent);
    box-shadow: 0 0 0 0.2rem rgba(185, 100, 138, 0.22), 0 0.8rem 1.8rem rgba(60, 38, 51, 0.1);
  }

  .janelle-bundle-picker__option:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .janelle-bundle-picker__image {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--jb-soft);
    color: var(--jb-accent);
    font-size: 2rem;
    font-weight: 700;
    aspect-ratio: 1 / 1;
  }

  .janelle-bundle-picker__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .janelle-bundle-picker__name {
    min-height: 2.8em;
    color: var(--jb-ink);
    font-size: 1.15rem;
    font-weight: 650;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .janelle-bundle-picker [data-add-bundle] {
    margin-top: 1.4rem;
    min-height: 5rem;
  }

  .janelle-bundle-picker [data-add-bundle][disabled] {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .janelle-bundle-picker__status,
  .janelle-bundle-picker__missing {
    margin: 0.8rem 0 0;
    color: var(--jb-muted);
    font-size: 1.2rem;
    text-align: center;
  }

  /* Picked-shade photo gallery, injected into the main gallery column (so it
     sits "at the top" with the product photos). Global class names + literal
     colors because it lives outside the .janelle-bundle-picker scope. */
  .janelle-shade-thumbs {
    margin: 1.2rem 0 0;
  }

  .janelle-shade-thumbs__label {
    display: block;
    margin: 0 0 0.6rem;
    color: #7b6572;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04rem;
    text-transform: uppercase;
  }

  .janelle-shade-thumbs__row {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    overscroll-behavior: contain;
    padding-bottom: 0.4rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(185, 100, 138, 0.5) transparent;
  }

  .janelle-shade-thumbs__item {
    flex: 0 0 auto;
    width: 6rem;
    height: 6rem;
    padding: 0;
    border: 0.1rem solid #ead7e2;
    border-radius: 0.6rem;
    overflow: hidden;
    background: #fff;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .janelle-shade-thumbs__item:hover {
    border-color: #d18bac;
  }

  .janelle-shade-thumbs__item.is-active {
    border-color: #b9648a;
    box-shadow: 0 0 0 0.2rem rgba(185, 100, 138, 0.25);
  }

  .janelle-shade-thumbs__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .janelle-bundle-picker {
      padding: 1.1rem;
    }

    .janelle-shade-thumbs__item {
      width: 5rem;
      height: 5rem;
    }

    .janelle-bundle-picker__selected {
      gap: 0.6rem;
    }

    .janelle-bundle-picker__slot-media {
      max-width: 4.6rem;
    }

    .janelle-bundle-picker__group legend {
      display: grid;
      gap: 0.35rem;
    }

    .janelle-bundle-picker__group legend em {
      max-width: none;
      text-align: left;
    }

    /* Mobile: swipe the rail — hide arrows so swatches get the full width and
       peek ~3 up. */
    .janelle-bundle-picker__scroll {
      display: none;
    }

    .janelle-bundle-picker__option {
      flex: 0 0 8.2rem;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById({{ builder_id | json }});
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const selected = new Map();
    let pendingNativeGallerySync = null;
    const requiredCount = root.querySelectorAll('[data-bundle-group]').length;
    const addButton = root.querySelector('[data-add-bundle]');
    const progress = root.querySelector('[data-bundle-progress]');
    const status = root.querySelector('[data-bundle-status]');
    const bundleName = {{ product.title | json }};
    const completeText = {{ block.settings.complete_text | json }};
    const incompleteText = {{ block.settings.incomplete_text | json }};
    const addingText = {{ block.settings.adding_text | json }};
    const errorText = {{ block.settings.error_text | json }};
    const cartMode = root.dataset.cartMode || 'bundle_product';
    const bundleVariantId = Number(root.dataset.bundleVariantId || 0);
    const useNativeGallerySync = {{ use_native_gallery_sync | json }};
    const nativeGalleryMediaFit = {{ section.settings.media_fit | json }};
    const nativeGalleryConstrainToViewport = {{ section.settings.constrain_to_viewport | json }};
    const slotLabels = {
      '1': {{ block.settings.label_1 | json }},
      '2': {{ block.settings.label_2 | json }},
      '3': {{ block.settings.label_3 | json }}
    };

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      })[char]);
    }

    function getProductInfo() {
      return root.closest('product-info') || document.querySelector('product-info');
    }

    function updateImageElement(imageElement, image, alt) {
      if (!imageElement || !image) return;
      imageElement.src = image;
      imageElement.removeAttribute('srcset');
      imageElement.removeAttribute('sizes');
      imageElement.alt = alt || '';
    }

    // True only for an <img> that is actually rendered at a meaningful size.
    // This is the key check: this store's gallery is injected by an app, and
    // Dawn's own .product__media-list is present but ZERO-SIZED (hidden), so
    // swapping it changed nothing visible. We must swap the image the customer
    // actually sees.
    function isVisibleImage(img) {
      if (!img || !img.isConnected) return false;
      const r = img.getBoundingClientRect();
      return r.width > 40 && r.height > 40;
    }

    // Largest visible <img> in the product media area — theme/app agnostic
    // fallback so this keeps working for any bundle or future gallery.
    function largestVisibleImage(scope) {
      let best = null;
      let bestArea = 0;
      scope.querySelectorAll('img').forEach((img) => {
        if (!isVisibleImage(img)) return;
        const r = img.getBoundingClientRect();
        const area = r.width * r.height;
        // Ignore tiny UI/thumbnail images; the hero is by far the biggest.
        if (area > 30000 && area > bestArea) {
          bestArea = area;
          best = img;
        }
      });
      return best;
    }

    // Resolve the primary visible hero image, trying the known app gallery
    // first, then Dawn's active/first slide, then the largest visible image.
    function getMainHeroImage() {
      const scope = getProductInfo() || document;
      const candidates = [
        '.pv-preview-gallery-main-img img',
        '.product__media-item.is-active img',
        '.product__media-item[aria-current="true"] img',
        '.product__media-list img'
      ];
      for (const sel of candidates) {
        const img = scope.querySelector(sel);
        if (isVisibleImage(img)) return img;
      }
      return largestVisibleImage(scope);
    }

    // Swap the visible main product photo. Robust to lazy-loading/srcset and to
    // app-injected galleries.
    function setHeroImage(url, selection) {
      if (!url) return;
      const img = getMainHeroImage();
      if (!img) return;
      const alt = `${selection.productTitle || bundleName} - ${selection.variantTitle || ''}`.trim();
      updateImageElement(img, url, alt);
      img.setAttribute('loading', 'eager');
      img.style.opacity = '1';

      const slide = img.closest('.product__media-item');
      const list = img.closest('.product__media-list');
      if (slide && list && typeof list.scrollTo === 'function') {
        list.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
      }
    }

    const baseUrl = (u) => String(u || '').split('?')[0];

    // Derive a shade's image run from the source product's ordered media: from
    // this variant's main photo up to the next variant's main photo. Mirrors how
    // the single product page groups a shade's photos. Falls back to the single
    // featured image when the source product's media isn't grouped.
    function computeShadeImages(option) {
      const group = option.closest('[data-bundle-group]');
      let media = [];
      try { media = JSON.parse(group && group.dataset.sourceMedia || '[]'); } catch (e) { media = []; }
      const featured = option.dataset.image;
      if (!media.length) return featured ? [featured] : [];

      const indexOfUrl = (u) => media.findIndex((m) => baseUrl(m) === baseUrl(u));
      const start = indexOfUrl(featured);
      if (start < 0) return featured ? [featured] : [];

      const featuredIndices = [...group.querySelectorAll('[data-bundle-option]')]
        .map((o) => indexOfUrl(o.dataset.image))
        .filter((i) => i >= 0)
        .sort((a, b) => a - b);
      const next = featuredIndices.find((i) => i > start);
      const run = media.slice(start, next === undefined ? media.length : next);
      return run.length ? run : [media[start]];
    }

    // Render the picked shade's images as a small photo gallery at the top of
    // the main product gallery column (big image already swapped; these are the
    // clickable thumbnails). One strip, reused for whichever shade was last picked.
    function showShadeGallery(images, selection) {
      const list = images && images.length ? images : (selection.image ? [selection.image] : []);
      if (!list.length) return;

      setHeroImage(list[0], selection);

      const heroImg = getMainHeroImage();
      // The gallery column (.pv-flex-column) holds the main image + its
      // thumbnails; appending here keeps the shade strip directly below the
      // whole gallery on desktop and stacked under it on mobile.
      const galleryCol = heroImg && (heroImg.closest('.pv-flex-column') || heroImg.closest('[class*="pv-preview-gallery"]'));

      let strip = document.getElementById('janelle-shade-thumbs');
      if (!strip) {
        strip = document.createElement('div');
        strip.id = 'janelle-shade-thumbs';
        strip.className = 'janelle-shade-thumbs';
        strip.innerHTML = '<span class="janelle-shade-thumbs__label"></span><div class="janelle-shade-thumbs__row"></div>';
        if (galleryCol) {
          galleryCol.appendChild(strip);
        } else {
          // Fallback: show inside the builder if the app gallery isn't found.
          root.querySelector('.janelle-bundle-picker__selected').insertAdjacentElement('afterend', strip);
        }
      }

      strip.querySelector('.janelle-shade-thumbs__label').textContent =
        `${selection.variantTitle || ''}`.trim();
      const row = strip.querySelector('.janelle-shade-thumbs__row');
      row.innerHTML = '';
      // A single image needs no thumbnails — the hero already shows it.
      strip.style.display = list.length < 2 ? 'none' : '';
      list.forEach((url, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'janelle-shade-thumbs__item' + (i === 0 ? ' is-active' : '');
        btn.innerHTML = `<img src="${escapeHtml(url)}" alt="" loading="lazy">`;
        btn.addEventListener('click', () => {
          setHeroImage(url, selection);
          row.querySelectorAll('.janelle-shade-thumbs__item').forEach((x) => x.classList.remove('is-active'));
          btn.classList.add('is-active');
        });
        row.appendChild(btn);
      });
    }

    function resizeUrl(url, width) {
      if (!url) return url;
      if (/([?&])width=\d+/.test(url)) return url.replace(/([?&])width=\d+/, `$1width=${width}`);
      return url + (url.includes('?') ? '&' : '?') + `width=${width}`;
    }

    // builder-2 only: drive the theme's own <media-gallery> component instead
    // of the generic hero-image swap above. Replaces the real GalleryViewer
    // and GalleryThumbnails content with the selected shade's own image set
    // (in the same order computeShadeImages already derives), then hands off
    // to media-gallery's own setActiveMedia() — the same method Dawn's native
    // thumbnail clicks use — so activation, scrolling and ARIA state all come
    // from the theme's existing, already-tested gallery code rather than new
    // CSS-selector guessing.
    function syncNativeGallery(images, selection) {
      if (!images || !images.length) return;
      const mediaGallery = document.querySelector('media-gallery');
      if (!mediaGallery || typeof mediaGallery.setActiveMedia !== 'function') return;

      const sectionId = mediaGallery.id.replace('MediaGallery-', '');
      const viewerList = mediaGallery.querySelector('[id^="Slider-Gallery"]');
      const thumbList = mediaGallery.querySelector('[id^="Slider-Thumbnails"]');
      if (!viewerList) return;

      const altText = `${selection.productTitle || bundleName} - ${selection.variantTitle || ''}`.trim();
      const runId = Date.now();
      const entries = images.map((url, i) => ({ id: `bundle-${runId}-${i}`, url }));

      viewerList.innerHTML = entries
        .map(
          (entry, i) => `
        <li id="Slide-${sectionId}-${entry.id}" class="product__media-item grid__item slider__slide${i === 0 ? ' is-active' : ''}" data-media-id="${sectionId}-${entry.id}">
          <div class="product-media-container media-type-image media-fit-${nativeGalleryMediaFit} global-media-settings gradient${nativeGalleryConstrainToViewport ? ' constrain-height' : ''}" style="--ratio: 1; --preview-ratio: 1;">
            <div class="product__media media media--transparent">
              <img src="${escapeHtml(resizeUrl(entry.url, 1946))}" alt="${escapeHtml(altText)}" loading="${i === 0 ? 'eager' : 'lazy'}">
            </div>
          </div>
        </li>`
        )
        .join('');

      if (thumbList) {
        thumbList.innerHTML = entries
          .map(
            (entry, i) => `
          <li id="Slide-Thumbnails-${sectionId}-${entry.id}" class="thumbnail-list__item slider__slide" data-target="${sectionId}-${entry.id}" data-media-position="${i + 1}">
            <button class="thumbnail global-media-settings global-media-settings--no-shadow" type="button" aria-label="${escapeHtml(altText)} ${i + 1}">
              <img src="${escapeHtml(resizeUrl(entry.url, 416))}" alt="${escapeHtml(altText)}" loading="lazy">
            </button>
          </li>`
          )
          .join('');

        thumbList.querySelectorAll('[data-target]').forEach((item) => {
          const button = item.querySelector('button');
          if (!button) return;
          button.addEventListener('click', () => mediaGallery.setActiveMedia(item.dataset.target, false));
        });
      }

      try {
        if (mediaGallery.elements?.viewer?.resetPages) mediaGallery.elements.viewer.resetPages();
        if (mediaGallery.elements?.thumbnails?.resetPages) mediaGallery.elements.thumbnails.resetPages();
      } catch (e) {
        /* pagination refresh is cosmetic only; safe to skip on failure */
      }

      // media-gallery's setActiveMedia() defers its scroll-into-view via a bare
      // setTimeout that closes over the specific <li> it was called with. If a
      // second rapid selection replaces that <li> (via the innerHTML swaps
      // above) before the deferred callback runs, the callback fires against a
      // now-detached node and throws. Coalescing to a zero-delay timeout (not
      // requestAnimationFrame, which can be paused entirely for a backgrounded
      // or inactive tab) ensures only the latest selection in a rapid burst
      // ever calls it, so the scroll callback always targets a still-attached
      // element and always actually runs.
      if (pendingNativeGallerySync) clearTimeout(pendingNativeGallerySync);
      const targetMediaId = `${sectionId}-${entries[0].id}`;
      pendingNativeGallerySync = setTimeout(() => {
        pendingNativeGallerySync = null;
        mediaGallery.setActiveMedia(targetMediaId, false);
      }, 0);
    }

    function refresh() {
      const count = selected.size;
      const complete = count === requiredCount && requiredCount > 0;
      progress.textContent = `${count}/${requiredCount}`;
      addButton.disabled = !complete;
      status.textContent = complete ? completeText : incompleteText;
    }

    // Show the desktop arrows only when a rail actually overflows, and disable
    // them at the start/end so it's clear when there's nowhere left to scroll.
    function syncRails() {
      root.querySelectorAll('.janelle-bundle-picker__rail').forEach((rail) => {
        const row = rail.querySelector('[data-options-row]');
        if (!row) return;
        const scrollable = row.scrollWidth - row.clientWidth > 4;
        rail.toggleAttribute('data-scrollable', scrollable);
        const prev = rail.querySelector('[data-direction="-1"]');
        const next = rail.querySelector('[data-direction="1"]');
        if (prev) prev.disabled = row.scrollLeft <= 2;
        if (next) next.disabled = row.scrollLeft >= row.scrollWidth - row.clientWidth - 2;
      });
    }

    root.querySelectorAll('[data-options-row]').forEach((row) => {
      row.addEventListener('scroll', syncRails, { passive: true });
    });
    window.addEventListener('resize', syncRails);
    window.addEventListener('load', syncRails);
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(syncRails);
      root.querySelectorAll('[data-options-row]').forEach((row) => ro.observe(row));
    }

    root.addEventListener('click', (event) => {
      const scrollButton = event.target.closest('[data-scroll-row]');
      if (scrollButton) {
        const rail = scrollButton.closest('.janelle-bundle-picker__rail');
        const row = rail?.querySelector('[data-options-row]');
        if (row) {
          const direction = Number(scrollButton.dataset.direction || 1);
          row.scrollBy({ left: direction * row.clientWidth * 0.82, behavior: 'smooth' });
        }
        return;
      }

      const option = event.target.closest('[data-bundle-option]');
      if (!option || option.disabled) return;

      const slot = option.dataset.slot;
      root.querySelectorAll(`[data-bundle-option][data-slot="${slot}"]`).forEach((button) => {
        button.setAttribute('aria-pressed', 'false');
      });
      option.setAttribute('aria-pressed', 'true');

      const selection = {
        id: Number(option.dataset.variantId),
        productTitle: option.dataset.productTitle,
        variantTitle: option.dataset.variantTitle,
        image: option.dataset.image
      };

      selected.set(slot, selection);

      const preview = root.querySelector(`[data-selected-slot="${slot}"]`);
      if (preview) {
        preview.classList.add('is-selected');
        preview.querySelector('[data-selected-title]').textContent = option.dataset.variantTitle;
        const media = preview.querySelector('[data-selected-media]');
        if (media && option.dataset.image) {
          media.innerHTML = `<img src="${escapeHtml(option.dataset.image)}" alt="${escapeHtml(option.dataset.variantTitle)}">`;
        }
      }

      if (useNativeGallerySync) {
        syncNativeGallery(computeShadeImages(option), selection);
      } else {
        showShadeGallery(computeShadeImages(option), selection);
      }
      refresh();
    });

    addButton.addEventListener('click', async () => {
      if (selected.size !== requiredCount) return;

      const bundleId = `BB-${Date.now()}`;
      const sortedEntries = [...selected.entries()].sort(
        ([slotA], [slotB]) => Number(slotA) - Number(slotB)
      );
      const selections = sortedEntries.map(([, item]) => item);
      const slotName = (slot) => slotLabels[slot] || `Shade ${slot}`;
      let items;

      if (cartMode === 'component_variants') {
        // Each shade is its own cart line — its variant title already names the
        // shade — so only carry hidden bookkeeping props for grouping.
        items = sortedEntries.map(([, item]) => ({
          id: item.id,
          quantity: 1,
          properties: {
            _Bundle: bundleName,
            _BundleID: bundleId
          }
        }));
      } else {
        if (!bundleVariantId) {
          status.textContent = errorText;
          return;
        }

        // Customer-facing cart shows only the chosen shade per slot
        // ("Lip Gloss 1: Stardust"). Bookkeeping props are prefixed with "_" so
        // the theme hides them from cart/checkout but keeps them on the order.
        const properties = {
          _Bundle: bundleName,
          _BundleID: bundleId,
          '_Component variant IDs': selections.map((item) => item.id).join(', ')
        };

        sortedEntries.forEach(([slot, item]) => {
          properties[slotName(slot)] = item.variantTitle;
        });

        items = [
          {
            id: bundleVariantId,
            quantity: 1,
            properties
          }
        ];
      }

      addButton.disabled = true;
      addButton.classList.add('loading');
      status.textContent = addingText;

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify({ items })
        });

        if (!response.ok) throw new Error('Cart add failed');
        window.location.href = '/cart';
      } catch (error) {
        addButton.disabled = false;
        addButton.classList.remove('loading');
        status.textContent = errorText;
      }
    });

    refresh();
    syncRails();
    // Swatch images load lazily and change the rail width; re-check shortly after.
    setTimeout(syncRails, 400);
    setTimeout(syncRails, 1200);
  })();
</script>
