{% comment %}
  Full-screen loading screen: logo inside a spinning ring.
  Fades out once the page has loaded and fades back in when leaving for another page on the store.
  Controlled from Theme settings → Loading screen.
{% endcomment %}
{%- if settings.page_loader_enable and request.design_mode == false -%}
  {%- liquid
    assign loader_logo = settings.page_loader_logo | default: settings.logo
    assign loader_size = settings.page_loader_size
  -%}
  <style>
    .page-loader {
      --page-loader-size: {{ loader_size }}px;
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: flex;
      align-items: center;
      justify-content: center;
      background: {{ settings.page_loader_background }};
      transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    .page-loader--hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .page-loader__spinner {
      position: relative;
      width: var(--page-loader-size);
      height: var(--page-loader-size);
    }

    .page-loader .page-loader__ring {
      display: block; /* base.css hides empty divs */
      position: absolute;
      inset: 0;
      border-radius: 50%;
      box-shadow: 0 2px 0 0 {{ settings.page_loader_color }};
      animation: page-loader-spin 1.5s linear infinite;
    }

    .page-loader__logo {
      position: absolute;
      inset: 18%;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: page-loader-blink 1.5s linear infinite;
    }

    .page-loader__logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    @keyframes page-loader-spin {
      to {
        transform: rotate(360deg);
      }
    }

    @keyframes page-loader-blink {
      25% {
        opacity: 0.5;
      }
      50% {
        opacity: 0;
      }
      75% {
        opacity: 0.5;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .page-loader__ring,
      .page-loader__logo {
        animation: none;
      }
    }
  </style>

  <div class="page-loader" id="PageLoader" role="status" aria-label="{{ 'accessibility.loading' | t }}">
    <div class="page-loader__spinner">
      <div class="page-loader__ring"></div>
      {%- if loader_logo != blank -%}
        <div class="page-loader__logo">
          {{
            loader_logo
            | image_url: width: 300
            | image_tag: alt: shop.name, loading: 'eager', fetchpriority: 'high', widths: '150, 300'
          }}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script>
    (function () {
      var loader = document.getElementById('PageLoader');
      if (!loader) return;

      function hide() {
        loader.classList.add('page-loader--hidden');
      }

      function show() {
        loader.classList.remove('page-loader--hidden');
      }

      if (document.readyState === 'complete') {
        hide();
      } else {
        window.addEventListener('load', hide);
        // Never keep customers waiting on a slow image or app script.
        setTimeout(hide, 3000);
      }

      // Pages restored with the back/forward buttons skip the load event.
      window.addEventListener('pageshow', function (event) {
        if (event.persisted) hide();
      });

      {%- if settings.page_loader_on_navigation %}
        document.addEventListener('click', function (event) {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          var link = event.target.closest('a[href]');
          if (!link || link.target === '_blank' || link.hasAttribute('download')) return;

          var url = new URL(link.href, window.location.href);
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname && url.search === window.location.search) return;
          if (/^\/(cart|checkout|checkouts)\b/.test(url.pathname) && link.closest('cart-drawer, cart-notification')) return;

          show();
          // Fallback in case the browser cancels the navigation.
          setTimeout(hide, 4000);
        });
      {%- endif %}
    })();
  </script>
{%- endif -%}
