{% doc %}
  @prompt
    Please help me create a dynamic product show card for my Shopify store. The card should display the product image and product name, and both the image and the name should be clickable links that lead to the respective product page.
    
    Additionally, I want the setup to be easily extendable so that I can add new products in the future without modifying the core code much. Ideally, the product list should be generated dynamically from a data source (such as a JSON array or Shopify's product objects), I need help creating a dynamic product show card layout for my Shopify store with the following requirements:
    
    1. Each product card should display the main product image and product name, and both should be clickable links that lead to the product’s page.
    
    2. The product grid should be responsive:
       - On laptops (desktop view), show products in rows with 2 products side by side.
       - On smaller screens (like mobile), stack the products vertically.
    
    3. When a user hovers over a product card, the image area should change to show other photos from that product's gallery (if available), cycling through those images or switching to the next image smoothly.
    
    4. The product cards should be generated dynamically from Shopify’s product objects or a data source, so I can add new products easily in the future without changing the code structure.
    
    5. Provide clean, well-structured Liquid code along with any necessary HTML, CSS, and JavaScript needed to implement this.
    
    6. The design should be visually appealing and user-friendly.
    
    Please provide the full code snippet or files that I can directly incorporate into my Shopify theme to achieve this functionality.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | times: 2 }});
  }

  .ai-product-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-card__image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-product-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity {{ block.settings.transition_speed }}s ease-in-out;
  }

  .ai-product-card__image-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-product-card__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-card__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-card__image-counter-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background-color: rgba(0, 0, 0, 0.7);
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-card__image-counter-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-product-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-product-card__title-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: {{ block.settings.title_color }};
    transition: color 0.3s ease;
  }

  .ai-product-card__title-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.title_hover_color }};
  }

  .ai-product-card__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-product-card__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 500;
  }

  .ai-product-card__vendor-{{ ai_gen_id }} {
    font-size: {{ block.settings.vendor_font_size }}px;
    color: {{ block.settings.vendor_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-gallery__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    background-color: #f9f9f9;
    border-radius: {{ block.settings.card_border_radius }}px;
    color: #666;
  }

  .ai-product-gallery__empty-state-{{ ai_gen_id }} h3 {
    margin: 0 0 12px;
    font-size: 20px;
    color: #333;
  }

  .ai-product-gallery__empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-gallery__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-product-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-product-card__price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<product-gallery-{{ ai_gen_id }} class="ai-product-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.selected_products.size > 0 %}
    <div class="ai-product-gallery__grid-{{ ai_gen_id }}">
      {% for product in block.settings.selected_products %}
        <div class="ai-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
          <div class="ai-product-card__image-wrapper-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-product-card__image-link-{{ ai_gen_id }}">
              {% if product.images.size > 0 %}
                {% for image in product.images limit: block.settings.max_images %}
                  <img
                    src="{{ image | image_url: width: 800 }}"
                    alt="{{ image.alt | escape }}"
                    width="800"
                    height="{{ 800 | divided_by: image.aspect_ratio | round }}"
                    loading="lazy"
                    class="ai-product-card__image-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                    data-image-index="{{ forloop.index0 }}"
                  >
                {% endfor %}
                {% if product.images.size > 1 %}
                  <div class="ai-product-card__image-counter-{{ ai_gen_id }}">
                    <span class="current-image">1</span>/<span class="total-images">{{ product.images.size | at_most: block.settings.max_images }}</span>
                  </div>
                {% endif %}
              {% else %}
                <div class="ai-product-card__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          </div>

          <div class="ai-product-card__content-{{ ai_gen_id }}">
            {% if block.settings.show_vendor and product.vendor != blank %}
              <div class="ai-product-card__vendor-{{ ai_gen_id }}">
                {{ product.vendor }}
              </div>
            {% endif %}

            <a href="{{ product.url }}" class="ai-product-card__title-link-{{ ai_gen_id }}">
              <h3 class="ai-product-card__title-{{ ai_gen_id }}">
                {{ product.title }}
              </h3>
            </a>

            {% if block.settings.show_price %}
              <div class="ai-product-card__price-{{ ai_gen_id }}">
                {% if product.compare_at_price > product.price %}
                  <span style="text-decoration: line-through; opacity: 0.6; margin-right: 8px;">
                    {{ product.compare_at_price | money }}
                  </span>
                {% endif %}
                {{ product.price | money }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-product-gallery__empty-state-{{ ai_gen_id }}">
      <h3>No products selected</h3>
      <p>Add products to showcase them with image gallery hover effect</p>
    </div>
  {% endif %}
</product-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cards = [];
        this.hoverIntervals = new Map();
      }

      connectedCallback() {
        this.initializeCards();
      }

      disconnectedCallback() {
        this.hoverIntervals.forEach((interval) => clearInterval(interval));
        this.hoverIntervals.clear();
      }

      initializeCards() {
        const cardElements = this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}');
        
        cardElements.forEach((card) => {
          const images = card.querySelectorAll('.ai-product-card__image-{{ ai_gen_id }}');
          const counter = card.querySelector('.ai-product-card__image-counter-{{ ai_gen_id }}');
          
          if (images.length > 1) {
            let currentIndex = 0;
            
            card.addEventListener('mouseenter', () => {
              const interval = setInterval(() => {
                images[currentIndex].classList.remove('active');
                currentIndex = (currentIndex + 1) % images.length;
                images[currentIndex].classList.add('active');
                
                if (counter) {
                  const currentSpan = counter.querySelector('.current-image');
                  if (currentSpan) {
                    currentSpan.textContent = currentIndex + 1;
                  }
                }
              }, {{ block.settings.transition_speed | times: 1000 }});
              
              this.hoverIntervals.set(card, interval);
            });
            
            card.addEventListener('mouseleave', () => {
              const interval = this.hoverIntervals.get(card);
              if (interval) {
                clearInterval(interval);
                this.hoverIntervals.delete(card);
              }
              
              images.forEach((img) => img.classList.remove('active'));
              images[0].classList.add('active');
              currentIndex = 0;
              
              if (counter) {
                const currentSpan = counter.querySelector('.current-image');
                if (currentSpan) {
                  currentSpan.textContent = '1';
                }
              }
            });
          }
        });
      }
    }

    customElements.define('product-gallery-{{ ai_gen_id }}', ProductGallery{{ ai_gen_id }});
  })();
</script>

