{% doc %}
  @prompt
    Create a variant image gallery filter for a product page. When a customer clicks on a variant (e.g., a color or shade), the product image gallery should display only the images associated with that variant — starting from the variant's assigned image and including all subsequent images up to (but not including) the next variant's assigned image. Images belonging to other variants should be hidden until their respective variant is selected. The behavior should update dynamically without page reload when switching between variants.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-variant-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-variant-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.image_spacing }}px;
  }

  .ai-variant-gallery__item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-variant-gallery__item-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-variant-gallery__item-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-variant-gallery__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-variant-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-variant-gallery__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<variant-gallery-{{ ai_gen_id }}
  class="ai-variant-gallery-{{ ai_gen_id }}"
  data-product-id="{{ product.id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-variant-gallery__grid-{{ ai_gen_id }}">
    {% if product.images.size > 0 %}
      {% for image in product.images %}
        <div
          class="ai-variant-gallery__item-{{ ai_gen_id }}"
          data-image-id="{{ image.id }}"
          data-image-position="{{ forloop.index }}"
        >
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div class="ai-variant-gallery__item-{{ ai_gen_id }}">
          <div class="ai-variant-gallery__placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</variant-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class VariantGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productId = this.dataset.productId;
        this.variantImageMap = new Map();
        this.currentVariantId = null;
      }

      connectedCallback() {
        this.buildVariantImageMap();
        this.initializeGallery();
        this.setupVariantChangeListener();
      }

      buildVariantImageMap() {
        const productData = this.getProductData();
        if (!productData || !productData.variants) return;

        const allImages = Array.from(this.querySelectorAll('[data-image-id]'));
        const imagePositions = allImages.map((img, index) => ({
          id: parseInt(img.dataset.imageId),
          position: index + 1,
          element: img
        }));

        productData.variants.forEach((variant) => {
          if (variant.featured_image && variant.featured_image.id) {
            const variantImageId = variant.featured_image.id;
            const startIndex = imagePositions.findIndex(img => img.id === variantImageId);

            if (startIndex !== -1) {
              const nextVariantImageIndex = this.findNextVariantImageIndex(
                productData.variants,
                variant.id,
                imagePositions
              );

              const endIndex = nextVariantImageIndex !== -1 
                ? nextVariantImageIndex 
                : imagePositions.length;

              const variantImages = imagePositions.slice(startIndex, endIndex);
              this.variantImageMap.set(variant.id, variantImages.map(img => img.id));
            }
          }
        });
      }

      findNextVariantImageIndex(variants, currentVariantId, imagePositions) {
        const currentVariantIndex = variants.findIndex(v => v.id === currentVariantId);
        
        for (let i = currentVariantIndex + 1; i < variants.length; i++) {
          const nextVariant = variants[i];
          if (nextVariant.featured_image && nextVariant.featured_image.id) {
            const nextImageId = nextVariant.featured_image.id;
            const nextIndex = imagePositions.findIndex(img => img.id === nextImageId);
            if (nextIndex !== -1) {
              return nextIndex;
            }
          }
        }
        
        return -1;
      }

      getProductData() {
        const productJson = document.querySelector(`script[data-product-json][data-product-id="${this.productId}"]`);
        if (productJson) {
          try {
            return JSON.parse(productJson.textContent);
          } catch (e) {
            console.error('Error parsing product JSON:', e);
          }
        }

        const productForm = document.querySelector(`product-form[data-product-id="${this.productId}"]`);
        if (productForm && productForm.productData) {
          return productForm.productData;
        }

        if (window.ShopifyAnalytics && window.ShopifyAnalytics.meta && window.ShopifyAnalytics.meta.product) {
          return window.ShopifyAnalytics.meta.product;
        }

        return null;
      }

      initializeGallery() {
        const urlParams = new URLSearchParams(window.location.search);
        const variantIdFromUrl = urlParams.get('variant');
        
        if (variantIdFromUrl) {
          this.currentVariantId = parseInt(variantIdFromUrl);
        } else {
          const productData = this.getProductData();
          if (productData && productData.selected_or_first_available_variant) {
            this.currentVariantId = productData.selected_or_first_available_variant.id;
          }
        }

        this.filterGalleryByVariant(this.currentVariantId);
      }

      setupVariantChangeListener() {
        document.addEventListener('variant:change', (event) => {
          if (event.detail && event.detail.variant && event.detail.variant.id) {
            this.currentVariantId = event.detail.variant.id;
            this.filterGalleryByVariant(this.currentVariantId);
          }
        });

        const variantSelects = document.querySelectorAll('variant-selects, variant-radios');
        variantSelects.forEach((selector) => {
          selector.addEventListener('change', () => {
            setTimeout(() => {
              const selectedVariantInput = document.querySelector('input[name="id"]:checked, select[name="id"]');
              if (selectedVariantInput) {
                const variantId = parseInt(selectedVariantInput.value);
                if (variantId && variantId !== this.currentVariantId) {
                  this.currentVariantId = variantId;
                  this.filterGalleryByVariant(variantId);
                }
              }
            }, 50);
          });
        });

        const observer = new MutationObserver(() => {
          const selectedVariantInput = document.querySelector('input[name="id"]:checked, select[name="id"]');
          if (selectedVariantInput) {
            const variantId = parseInt(selectedVariantInput.value);
            if (variantId && variantId !== this.currentVariantId) {
              this.currentVariantId = variantId;
              this.filterGalleryByVariant(variantId);
            }
          }
        });

        const formElement = document.querySelector('form[action*="/cart/add"]');
        if (formElement) {
          observer.observe(formElement, {
            attributes: true,
            subtree: true,
            attributeFilter: ['checked', 'selected']
          });
        }
      }

      filterGalleryByVariant(variantId) {
        if (!variantId) {
          this.showAllImages();
          return;
        }

        const variantImageIds = this.variantImageMap.get(variantId);
        const allImageElements = this.querySelectorAll('[data-image-id]');

        if (!variantImageIds || variantImageIds.length === 0) {
          this.showAllImages();
          return;
        }

        allImageElements.forEach((imageElement) => {
          const imageId = parseInt(imageElement.dataset.imageId);
          if (variantImageIds.includes(imageId)) {
            imageElement.classList.remove('hidden');
          } else {
            imageElement.classList.add('hidden');
          }
        });
      }

      showAllImages() {
        const allImageElements = this.querySelectorAll('[data-image-id]');
        allImageElements.forEach((imageElement) => {
          imageElement.classList.remove('hidden');
        });
      }
    }

    customElements.define('variant-gallery-{{ ai_gen_id }}', VariantGallery{{ ai_gen_id }});
  })();
</script>

<script type="application/json" data-product-json data-product-id="{{ product.id }}">
  {{ product | json }}
</script>

{% schema %}
{
  "name": "Variant image gallery",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "image_spacing",
      "label": "Image spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Variant image gallery"
    }
  ]
}
{% endschema %}
