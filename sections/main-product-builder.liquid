{%- liquid
  assign bb = 'bundle-builder-' | append: section.id
  assign hero_image_class = bb | append: '__hero-image'
  assign fallback_image = product.featured_image
-%}

<section class="{{ bb }} color-{{ section.settings.color_scheme }} gradient" data-bundle-builder>
  <div class="{{ bb }}__inner page-width">
    <div class="{{ bb }}__gallery" aria-live="polite">
      <div class="{{ bb }}__hero">
        {%- if fallback_image -%}
          {{
            fallback_image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              widths: '420, 720, 960, 1200',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: hero_image_class,
              alt: product.title
          }}
        {%- endif -%}
      </div>

      <div class="{{ bb }}__selected">
        {%- for block in section.blocks -%}
          {%- liquid
            assign picked_product = block.settings.source_product
            assign source_handle = block.settings.source_handle
            if source_handle == blank
              assign source_handle = picked_product.handle | default: picked_product
            endif
            assign source_product = picked_product
            if source_product.variants.size == blank and source_handle != blank
              assign source_product = all_products[source_handle]
            endif
          -%}
          {%- assign slot_label = block.settings.label | default: source_product.title | default: 'Choose shade' -%}
          <div class="{{ bb }}__slot" data-slot-preview="{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="{{ bb }}__slot-media">
              {%- if source_product.featured_image -%}
                {{
                  source_product.featured_image
                  | image_url: width: 220
                  | image_tag: loading: 'lazy', widths: '120, 180, 220', alt: slot_label
                }}
              {%- elsif fallback_image -%}
                {{
                  fallback_image
                  | image_url: width: 220
                  | image_tag: loading: 'lazy', widths: '120, 180, 220', alt: slot_label
                }}
              {%- endif -%}
            </div>
            <div class="{{ bb }}__slot-copy">
              <span class="{{ bb }}__slot-label">{{ slot_label }}</span>
              <strong data-slot-title>{{ section.settings.empty_slot_text }}</strong>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="{{ bb }}__panel">
      {%- if section.settings.eyebrow != blank -%}
        <p class="{{ bb }}__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="{{ bb }}__title">{{ product.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <div class="{{ bb }}__subtitle rte">{{ section.settings.subtitle }}</div>
      {%- endif -%}

      <div class="{{ bb }}__price-row">
        <span>{{ section.settings.price_label }}</span>
        <strong data-bundle-total>{{ 0 | money }}</strong>
      </div>

      <div class="{{ bb }}__steps">
        {%- for block in section.blocks -%}
          {%- liquid
            assign picked_product = block.settings.source_product
            assign source_handle = block.settings.source_handle
            if source_handle == blank
              assign source_handle = picked_product.handle | default: picked_product
            endif
            assign source_product = picked_product
            if source_product.variants.size == blank and source_handle != blank
              assign source_product = all_products[source_handle]
            endif
          -%}
          {%- assign slot_label = block.settings.label | default: source_product.title | default: 'Choose shade' -%}
          <fieldset
            class="{{ bb }}__step"
            data-slot="{{ block.id }}"
            data-slot-label="{{ slot_label | escape }}"
            data-required="true"
            {{ block.shopify_attributes }}
          >
            <legend>
              <span>Step {{ forloop.index }}</span>
              {{ slot_label }}
            </legend>

            {%- if source_product != blank and source_product.variants.size > 0 -%}
              <div class="{{ bb }}__options" role="list">
                {%- for variant in source_product.variants -%}
                  {%- liquid
                    assign variant_media = variant.featured_media.preview_image
                    if variant_media == blank
                      assign variant_media = variant.featured_image
                    endif
                    if variant_media == blank
                      assign variant_media = source_product.featured_image
                    endif
                  -%}
                  <button
                    class="{{ bb }}__option"
                    type="button"
                    data-slot-option
                    data-slot-id="{{ block.id }}"
                    data-variant-id="{{ variant.id }}"
                    data-variant-title="{{ variant.title | escape }}"
                    data-product-title="{{ source_product.title | escape }}"
                    data-price="{{ variant.price }}"
                    data-image="{% if variant_media %}{{ variant_media | image_url: width: 720 }}{% endif %}"
                    aria-pressed="false"
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    <span class="{{ bb }}__option-image">
                      {%- if variant_media -%}
                        {{
                          variant_media
                          | image_url: width: 180
                          | image_tag: loading: 'lazy', widths: '90, 140, 180', alt: variant.title
                        }}
                      {%- endif -%}
                    </span>
                    <span class="{{ bb }}__option-title">{{ variant.title }}</span>
                    {%- unless variant.available -%}
                      <span class="{{ bb }}__option-status">Sold out</span>
                    {%- endunless -%}
                  </button>
                {%- endfor -%}
              </div>
            {%- else -%}
              <p class="{{ bb }}__empty">
                Source product not found for {{ slot_label }}.
                {%- if source_handle != blank -%} Check the handle: {{ source_handle }}.{%- endif -%}
              </p>
            {%- endif -%}
          </fieldset>
        {%- endfor -%}
      </div>

      <button class="{{ bb }}__add button button--primary" type="button" disabled data-add-bundle>
        {{ section.settings.button_label }}
      </button>
      <p class="{{ bb }}__status" role="status" data-builder-status>
        {{ section.settings.incomplete_text }}
      </p>
    </div>
  </div>
</section>

<style>
  .{{ bb }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .{{ bb }}__inner {
    display: grid;
    gap: 3rem;
  }

  .{{ bb }}__gallery {
    min-width: 0;
  }

  .{{ bb }}__hero {
    overflow: hidden;
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    border-radius: 0.8rem;
    background: rgba(var(--color-foreground), 0.035);
    aspect-ratio: 1 / 1;
  }

  .{{ bb }}__hero-image,
  .{{ bb }}__hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .{{ bb }}__selected {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.2rem;
  }

  .{{ bb }}__slot {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 0.8rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-radius: 0.8rem;
    background: rgb(var(--color-background));
  }

  .{{ bb }}__slot.is-selected {
    border-color: rgba(var(--color-foreground), 0.34);
    box-shadow: 0 0.8rem 2rem rgba(var(--color-foreground), 0.06);
  }

  .{{ bb }}__slot-media {
    overflow: hidden;
    border-radius: 0.6rem;
    background: rgba(var(--color-foreground), 0.035);
    aspect-ratio: 1 / 1;
  }

  .{{ bb }}__slot-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .{{ bb }}__slot-copy {
    min-width: 0;
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .{{ bb }}__slot-label {
    display: block;
    color: rgba(var(--color-foreground), 0.62);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
  }

  .{{ bb }}__slot-copy strong {
    display: block;
    margin-top: 0.3rem;
    overflow-wrap: anywhere;
  }

  .{{ bb }}__panel {
    min-width: 0;
  }

  .{{ bb }}__eyebrow {
    margin: 0 0 0.8rem;
    color: rgba(var(--color-foreground), 0.68);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.12rem;
    text-transform: uppercase;
  }

  .{{ bb }}__title {
    margin: 0;
    font-size: clamp(3rem, 4.5vw, 5rem);
    line-height: 1;
  }

  .{{ bb }}__subtitle {
    margin-top: 1.4rem;
    color: rgba(var(--color-foreground), 0.76);
  }

  .{{ bb }}__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin: 2rem 0;
    padding: 1.2rem 0;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.1);
  }

  .{{ bb }}__price-row span {
    color: rgba(var(--color-foreground), 0.7);
    font-size: 1.3rem;
  }

  .{{ bb }}__price-row strong {
    font-size: 1.8rem;
  }

  .{{ bb }}__steps {
    display: grid;
    gap: 1.4rem;
  }

  .{{ bb }}__step {
    min-width: 0;
    margin: 0;
    padding: 1.2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-radius: 0.8rem;
  }

  .{{ bb }}__step legend {
    display: flex;
    gap: 0.8rem;
    padding: 0 0.4rem;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .{{ bb }}__step legend span {
    color: rgba(var(--color-foreground), 0.56);
    font-size: 1rem;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
  }

  .{{ bb }}__options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.8rem, 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
    max-height: 34rem;
    overflow-y: auto;
    padding-right: 0.2rem;
  }

  .{{ bb }}__option {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
    padding: 0.7rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    border-radius: 0.7rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    cursor: pointer;
    text-align: left;
    transition: border-color var(--duration-short) ease, box-shadow var(--duration-short) ease, transform var(--duration-short) ease;
  }

  .{{ bb }}__option:hover {
    border-color: rgba(var(--color-foreground), 0.34);
    transform: translateY(-0.1rem);
  }

  .{{ bb }}__option[aria-pressed='true'] {
    border-color: rgb(var(--color-foreground));
    box-shadow: 0 0 0 0.2rem rgb(var(--color-foreground));
  }

  .{{ bb }}__option:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .{{ bb }}__option-image {
    overflow: hidden;
    border-radius: 0.5rem;
    background: rgba(var(--color-foreground), 0.035);
    aspect-ratio: 1 / 1;
  }

  .{{ bb }}__option-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .{{ bb }}__option-title {
    min-height: 2.8em;
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .{{ bb }}__option-status {
    color: rgba(var(--color-foreground), 0.62);
    font-size: 1.1rem;
  }

  .{{ bb }}__add {
    width: 100%;
    margin-top: 1.8rem;
  }

  .{{ bb }}__add[disabled] {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .{{ bb }}__status {
    min-height: 1.4em;
    margin: 1rem 0 0;
    color: rgba(var(--color-foreground), 0.68);
    font-size: 1.25rem;
    text-align: center;
  }

  .{{ bb }}__empty {
    margin: 1rem 0 0;
    color: rgba(var(--color-foreground), 0.68);
    font-size: 1.3rem;
  }

  @media screen and (min-width: 990px) {
    .{{ bb }}__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(34rem, 0.95fr);
      align-items: start;
      gap: 5rem;
    }

    .{{ bb }}__gallery {
      position: sticky;
      top: 3rem;
    }
  }

  @media screen and (max-width: 749px) {
    .{{ bb }} {
      padding: {{ section.settings.padding_top | divided_by: 2 }}px 0 {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }

    .{{ bb }}__selected {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .{{ bb }}__options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-height: none;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('.{{ bb }}[data-bundle-builder]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const selected = new Map();
    const addButton = root.querySelector('[data-add-bundle]');
    const status = root.querySelector('[data-builder-status]');
    const total = root.querySelector('[data-bundle-total]');
    const hero = root.querySelector('.{{ bb }}__hero img');
    const slotCount = root.querySelectorAll('[data-slot]').length;
    const currencyFormat = {{ shop.money_format | json }};
    const bundleName = {{ product.title | json }};
    const incompleteText = {{ section.settings.incomplete_text | json }};
    const completeText = {{ section.settings.complete_text | json }};
    const addingText = {{ section.settings.adding_text | json }};
    const errorText = {{ section.settings.error_text | json }};

    function formatMoney(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(cents, currencyFormat);
      }

      return (cents / 100).toLocaleString(undefined, {
        style: 'currency',
        currency: {{ cart.currency.iso_code | json }}
      });
    }

    function renderSlot(selection) {
      const slot = root.querySelector(`[data-slot-preview="${selection.slotId}"]`);
      if (!slot) return;

      const imageWrap = slot.querySelector('.{{ bb }}__slot-media');
      const title = slot.querySelector('[data-slot-title]');
      slot.classList.add('is-selected');
      title.textContent = selection.variantTitle;

      if (selection.image) {
        imageWrap.innerHTML = `<img src="${selection.image}" alt="${selection.productTitle} ${selection.variantTitle}" loading="lazy">`;
      }
    }

    function refresh() {
      const selectedItems = [...selected.values()];
      const isComplete = selectedItems.length === slotCount && slotCount > 0;
      const cents = selectedItems.reduce((sum, item) => sum + item.price, 0);

      total.textContent = formatMoney(cents);
      addButton.disabled = !isComplete;
      status.textContent = isComplete ? completeText : incompleteText.replace('[count]', selectedItems.length).replace('[total]', slotCount);

      const lastWithImage = [...selectedItems].reverse().find((item) => item.image);
      if (lastWithImage && hero) {
        hero.src = lastWithImage.image;
        hero.removeAttribute('srcset');
        hero.alt = `${lastWithImage.productTitle} ${lastWithImage.variantTitle}`;
      }
    }

    root.addEventListener('click', (event) => {
      const button = event.target.closest('[data-slot-option]');
      if (!button || button.disabled) return;

      const slotId = button.dataset.slotId;
      root.querySelectorAll(`[data-slot-option][data-slot-id="${slotId}"]`).forEach((option) => {
        option.setAttribute('aria-pressed', 'false');
      });
      button.setAttribute('aria-pressed', 'true');

      const selection = {
        slotId,
        variantId: Number(button.dataset.variantId),
        variantTitle: button.dataset.variantTitle,
        productTitle: button.dataset.productTitle,
        price: Number(button.dataset.price || 0),
        image: button.dataset.image
      };

      selected.set(slotId, selection);
      renderSlot(selection);
      refresh();
    });

    addButton.addEventListener('click', async () => {
      if (selected.size !== slotCount) return;

      const bundleId = `BB-${Date.now()}`;
      const items = [...selected.values()].map((item) => ({
        id: item.variantId,
        quantity: 1,
        properties: {
          Bundle: bundleName,
          BundleID: bundleId,
          Selection: `${item.productTitle} - ${item.variantTitle}`
        }
      }));

      addButton.disabled = true;
      status.textContent = addingText;

      try {
        const response = await fetch(`${routes.cart_add_url}.js`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify({ items })
        });

        if (!response.ok) throw new Error('Cart add failed');

        window.location.href = routes.cart_url;
      } catch (error) {
        addButton.disabled = false;
        status.textContent = errorText;
      }
    });

    refresh();
  })();
</script>

{% schema %}
{
  "name": "Bundle builder product",
  "tag": "section",
  "class": "section-bundle-builder-product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Build your set"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Pick each shade from the real Janelle products. Your selections appear in the kit preview before adding to cart.</p>"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price label",
      "default": "Selected total"
    },
    {
      "type": "text",
      "id": "empty_slot_text",
      "label": "Empty slot text",
      "default": "Not selected"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add selected set to cart"
    },
    {
      "type": "text",
      "id": "incomplete_text",
      "label": "Incomplete status",
      "default": "Choose all shades to continue ([count]/[total])"
    },
    {
      "type": "text",
      "id": "complete_text",
      "label": "Complete status",
      "default": "Your set is ready."
    },
    {
      "type": "text",
      "id": "adding_text",
      "label": "Adding status",
      "default": "Adding your set..."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Error status",
      "default": "Could not add your set. Please try again."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "slot",
      "name": "Product slot",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Slot label",
          "default": "Choose shade"
        },
        {
          "type": "text",
          "id": "source_handle",
          "label": "Fallback product handle",
          "info": "Used if the product picker does not resolve in preview. Example: lip-gloss-squeeze-tube"
        },
        {
          "type": "product",
          "id": "source_product",
          "label": "Source product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bundle builder product",
      "blocks": [
        {
          "type": "slot",
          "settings": {
            "label": "Squeeze gloss"
          }
        },
        {
          "type": "slot",
          "settings": {
            "label": "Brush gloss"
          }
        },
        {
          "type": "slot",
          "settings": {
            "label": "Lip liner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
