{% comment %}
  Wishlist page: lists the products saved with the heart buttons (stored in this browser).
{% endcomment %}
{{ 'wishlist.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .wishlist-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .wishlist-{{ section.id }} .wishlist__heading {
    margin: 0 0 2.4rem;
  }

  .wishlist-{{ section.id }} .wishlist__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .wishlist-{{ section.id }} .wishlist__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3rem 2rem;
    }
  }

  .wishlist-{{ section.id }} .wishlist__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 16px;
    background: rgba(var(--color-foreground), 0.04);
  }

  .wishlist-{{ section.id }} .wishlist__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wishlist-{{ section.id }} .wishlist__remove {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ffffff;
    color: #c07496;
    cursor: pointer;
    box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.12);
  }

  .wishlist-{{ section.id }} .wishlist__remove svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .wishlist-{{ section.id }} .wishlist__title {
    display: block;
    margin-top: 1.2rem;
    color: rgb(var(--color-foreground));
    font-size: 1.6rem;
    text-decoration: none;
  }

  .wishlist-{{ section.id }} .wishlist__price {
    margin-top: 0.4rem;
    font-size: 1.5rem;
    color: rgba(var(--color-foreground), 0.85);
  }

  .wishlist-{{ section.id }} .wishlist__empty {
    text-align: center;
    padding: 4rem 0;
  }

  .wishlist-{{ section.id }} .wishlist__empty[hidden],
  .wishlist-{{ section.id }} .wishlist__grid[hidden] {
    display: none;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width wishlist-{{ section.id }}">
    <h1 class="wishlist__heading {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h1>

    <ul class="wishlist__grid" role="list" data-wishlist-grid hidden></ul>

    <div class="wishlist__empty" data-wishlist-empty hidden>
      <p>{{ section.settings.empty_text | escape }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ section.settings.empty_button | escape }}</a>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.wishlist-{{ section.id }}');
    var grid = root.querySelector('[data-wishlist-grid]');
    var empty = root.querySelector('[data-wishlist-empty]');
    var moneyFormat = {{ shop.money_format | json }};
    var rootUrl = {{ routes.root_url | json }};
    if (rootUrl.slice(-1) !== '/') rootUrl += '/';

    function formatMoney(cents) {
      var amount = (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return moneyFormat.replace(/\{\{\s*\w+\s*\}\}/, amount);
    }

    function render() {
      var handles = window.JanelleWishlist ? window.JanelleWishlist.read() : [];
      if (!handles.length) {
        grid.innerHTML = '';
        grid.hidden = true;
        empty.hidden = false;
        return;
      }

      Promise.all(
        handles.map(function (handle) {
          return fetch(rootUrl + 'products/' + encodeURIComponent(handle) + '.js')
            .then(function (response) {
              return response.ok ? response.json() : null;
            })
            .catch(function () {
              return null;
            });
        })
      ).then(function (products) {
        products = products.filter(Boolean);
        grid.innerHTML = '';
        products.forEach(function (product) {
          var item = document.createElement('li');
          var image = product.featured_image
            ? '<img src="' + product.featured_image + (product.featured_image.indexOf('?') === -1 ? '?' : '&') + 'width=600" alt="" loading="lazy">'
            : '';
          item.innerHTML =
            '<a class="wishlist__media" href="' + product.url + '">' + image + '</a>' +
            '<a class="wishlist__title" href="' + product.url + '"></a>' +
            '<div class="wishlist__price">' + formatMoney(product.price) + '</div>';
          item.querySelector('.wishlist__title').textContent = product.title;

          var remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'wishlist__remove';
          remove.setAttribute('aria-label', 'Remove ' + product.title + ' from wishlist');
          remove.innerHTML =
            '<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
          remove.addEventListener('click', function () {
            window.JanelleWishlist.remove(product.handle);
          });
          item.querySelector('.wishlist__media').after(remove);
          item.style.position = 'relative';
          grid.appendChild(item);
        });
        grid.hidden = products.length === 0;
        empty.hidden = products.length !== 0;
      });
    }

    document.addEventListener('wishlist:change', render);
    if (window.JanelleWishlist) {
      render();
    } else {
      document.addEventListener('DOMContentLoaded', render);
    }
  })();
</script>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "My wishlist"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when empty",
      "default": "Your wishlist is empty. Tap the heart on any product to save it here."
    },
    {
      "type": "text",
      "id": "empty_button",
      "label": "Button when empty",
      "default": "Shop now"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
