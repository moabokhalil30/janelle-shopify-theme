{{ 'section-hero-social-proof.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Critical fallback. On 2026-08-05 the stylesheet above 504'd from the CDN and the
  hero image rendered at its natural 3703x5097, giving a 9892px-tall homepage with
  horizontal overflow. These three declarations are the only ones that stand between
  a missing stylesheet and a broken page, so they are inlined and cannot fail to load.
  Everything else stays in the stylesheet.
{%- endcomment -%}
<style>
  .hero-social-proof__media { overflow: hidden; }
  .hero-social-proof__media img { width: 100%; max-width: 100%; height: auto; display: block; }
</style>

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
    assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
  endif

  assign has_cta = false
  for block in section.blocks
    if block.type == 'cta_button' and block.settings.label != blank
      assign has_cta = true
      break
    endif
  endfor
-%}

<div
  class="hero-social-proof color-{{ section.settings.color_scheme }} gradient hero-social-proof--m-{{ section.settings.image_ratio_mobile }} hero-social-proof--d-{{ section.settings.image_ratio_desktop }} hero-social-proof--desktop-{{ section.settings.desktop_layout }}{% unless section.settings.full_width %} hero-social-proof--inset{% endunless %}"
  style="--hero-focal: {{ section.settings.focal_point }};"
>
  <div class="hero-social-proof__media{% unless has_image %} hero-social-proof__media--placeholder{% endunless %}">
    {%- if has_image -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          fetchpriority: fetch_priority
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="hero-social-proof__content">
    <div class="hero-social-proof__inner">
      {%- comment -%}
        Fixed render order — headline, then social proof, then buttons, then the
        badge row — so the hero always reads the same way regardless of how the
        blocks happen to be dragged around in the theme editor.
      {%- endcomment -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
            <div class="hero-social-proof__text" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="hero-social-proof__heading {{ block.settings.heading_size }}">
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="hero-social-proof__subheading">{{ block.settings.subheading }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'rating' -%}
          {%- comment -%}
            Requires the text: stars on their own would imply a rating with
            nothing to back it up. Fill the social proof line and they appear.
          {%- endcomment -%}
          {%- if block.settings.rating_text != blank -%}
            {%- liquid
              assign star_pct = block.settings.rating | times: 20
              capture star_row
                for i in (1..5)
                  echo '<svg class="hero-social-proof__star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 1.5l3.09 6.26 6.91 1-5 4.87 1.18 6.87L12 17.27l-6.18 3.23L7 13.63l-5-4.87 6.91-1z"/></svg>'
                endfor
              endcapture
            -%}
            <div class="hero-social-proof__proof" {{ block.shopify_attributes }}>
              {%- if block.settings.show_stars -%}
                <span
                  class="hero-social-proof__stars"
                  style="--hero-star-color: {{ block.settings.star_color }}; --hero-star-pct: {{ star_pct }}%;"
                  role="img"
                  aria-label="{{ block.settings.rating }} {{ 'accessibility.star_reviews_info' | t: rating_max: 5 | default: 'out of 5 stars' }}"
                >
                  <span class="hero-social-proof__stars-row hero-social-proof__stars-row--track" aria-hidden="true">
                    {{- star_row -}}
                  </span>
                  <span class="hero-social-proof__stars-row hero-social-proof__stars-row--fill" aria-hidden="true">
                    {{- star_row -}}
                  </span>
                </span>
              {%- endif -%}
              <span class="hero-social-proof__proof-text">{{ block.settings.rating_text }}</span>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_cta -%}
        <div class="hero-social-proof__ctas">
          {%- for block in section.blocks -%}
            {%- if block.type == 'cta_button' and block.settings.label != blank -%}
              <a
                {% if block.settings.link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.link }}"
                {% endif %}
                class="hero-social-proof__cta{% if block.settings.style_secondary %} hero-social-proof__cta--secondary{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="hero-social-proof__cta-label">
                  {{- block.settings.label | escape -}}
                  <span class="hero-social-proof__cta-caret">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </span>
                {%- if block.settings.thumbnail != blank -%}
                  <span class="hero-social-proof__cta-thumb">
                    {{
                      block.settings.thumbnail
                      | image_url: width: 144
                      | image_tag: width: 72, height: 72, loading: 'lazy', alt: ''
                    }}
                  </span>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_badge' -%}
          {%- if block.settings.text != blank or block.settings.logo != blank -%}
            <div class="hero-social-proof__badge" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
              {%- if block.settings.logo != blank -%}
                {{
                  block.settings.logo
                  | image_url: width: 300
                  | image_tag:
                    class: 'hero-social-proof__badge-logo',
                    widths: '100, 150, 200, 300',
                    loading: 'lazy',
                    alt: ''
                }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero (social proof)",
  "tag": "section",
  "class": "section section-hero-social-proof",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "options": [
        { "value": "natural", "label": "Natural (no cropping)" },
        { "value": "landscape", "label": "Landscape (16:9)" },
        { "value": "wide", "label": "Wide (3:2)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "square",
      "label": "Image shape — mobile",
      "info": "'Natural' shows the whole photo but on a tall photo it pushes the button below the fold. Square keeps the button on screen."
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "options": [
        { "value": "side_by_side", "label": "Photo beside the text" },
        { "value": "stacked", "label": "Photo above the text" }
      ],
      "default": "side_by_side",
      "label": "Desktop layout",
      "info": "A desktop screen is wide and short. Stacking a full-width photo above the text pushes the button off screen, so side-by-side keeps the whole hero visible at once."
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "options": [
        { "value": "natural", "label": "Natural (no cropping)" },
        { "value": "cinematic", "label": "Cinematic (21:9)" },
        { "value": "landscape", "label": "Landscape (16:9)" },
        { "value": "wide", "label": "Wide (3:2)" },
        { "value": "square", "label": "Square (1:1)" }
      ],
      "default": "cinematic",
      "label": "Image shape — desktop",
      "info": "Only applies when the desktop layout is 'Photo above the text'. Side-by-side sizes the photo to the screen automatically."
    },
    {
      "type": "select",
      "id": "focal_point",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center", "label": "Centre" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center",
      "label": "Image focal point",
      "info": "Which part of the photo stays visible when it gets cropped. Has no effect on 'Natural'."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-2",
      "label": "Colour scheme",
      "info": "Sets the background and text colour under the photo. The headline needs a dark text scheme to be readable."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "Full-width image",
      "info": "Untick to inset the image with a margin on either side."
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ],
          "default": "h1",
          "label": "Heading size"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "Subheading",
          "info": "One line under the headline saying what the product actually does. Leave blank to hide."
        }
      ]
    },
    {
      "type": "rating",
      "name": "Stars & social proof",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_stars",
          "default": true,
          "label": "Show stars"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": 5,
          "label": "Stars filled",
          "info": "Supports part-filled stars, e.g. 4.8."
        },
        {
          "type": "color",
          "id": "star_color",
          "default": "#b9648a",
          "label": "Star colour"
        },
        {
          "type": "inline_richtext",
          "id": "rating_text",
          "label": "Social proof line",
          "info": "e.g. Loved by <b>3,000+</b> happy customers. Use bold on the number. Leave blank to hide the whole line."
        }
      ]
    },
    {
      "type": "cta_button",
      "name": "CTA button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Shop all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "style_secondary",
          "default": false,
          "label": "Use outlined style",
          "info": "Tick this on your second button so the main one stands out."
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail (optional)",
          "info": "Small square product photo shown on the right of the button."
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge / press line",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "e.g. free shipping, guarantee, or a press mention. Leave blank to hide."
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Press / award logo (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (social proof)",
      "blocks": [
        { "type": "heading" },
        { "type": "rating" },
        { "type": "cta_button" },
        { "type": "trust_badge" }
      ]
    }
  ]
}
{% endschema %}
