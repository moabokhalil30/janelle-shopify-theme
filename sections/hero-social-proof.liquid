{{ 'section-hero-social-proof.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div class="hero-social-proof">
  {%- if section.settings.image != blank -%}
    <div class="hero-social-proof__media">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: section.settings.image.width | divided_by: section.settings.image.aspect_ratio,
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          fetchpriority: fetch_priority
      }}
    </div>
  {%- endif -%}

  {%- if section.settings.image_overlay_opacity > 0 -%}
    <div class="hero-social-proof__overlay" style="opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="hero-social-proof__scrim"></div>

  <div class="hero-social-proof__content page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'rating' -%}
          {%- if block.settings.rating_text != blank -%}
            <div class="hero-social-proof__rating" {{ block.shopify_attributes }}>
              {{ block.settings.rating_text }}
            </div>
          {%- endif -%}

        {%- when 'heading' -%}
          {%- if block.settings.heading != blank -%}
            <h1 class="hero-social-proof__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h1>
          {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}

    {%- assign has_cta = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'cta_button' and block.settings.label != blank -%}
        {%- assign has_cta = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_cta -%}
      <div class="hero-social-proof__ctas">
        {%- for block in section.blocks -%}
          {%- if block.type == 'cta_button' and block.settings.label != blank -%}
            <a
              {% if block.settings.link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ block.settings.link }}"
              {% endif %}
              class="hero-social-proof__cta"
              {{ block.shopify_attributes }}
            >
              <span class="hero-social-proof__cta-label">
                {{- block.settings.label | escape -}}
                <span class="icon-caret">{{ 'icon-caret.svg' | inline_asset_content }}</span>
              </span>
              {%- if block.settings.thumbnail != blank -%}
                <span class="hero-social-proof__cta-thumb">
                  {{ block.settings.thumbnail | image_url: width: 100 | image_tag: width: 72, height: 72, loading: 'lazy' }}
                </span>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'trust_badge' and block.settings.text != blank -%}
        <div class="hero-social-proof__badge" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 200 | image_tag: class: 'hero-social-proof__badge-logo', widths: '100, 150, 200', loading: 'lazy' }}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero (social proof)",
  "tag": "section",
  "class": "section section-hero-social-proof",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image overlay darkness",
      "info": "Darkens the whole image. Use if the headline or reviews text is hard to read.",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "Rating & reviews",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating line",
          "info": "Type this exactly as you want it to appear, e.g. \"4.8 ★ 1,204 Reviews\". Leave blank to hide."
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" }
          ],
          "default": "h0",
          "label": "Heading size"
        }
      ]
    },
    {
      "type": "cta_button",
      "name": "CTA button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "info": "e.g. Shop All"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail (optional)",
          "info": "Small square image shown on the right side of the button, like a product photo."
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge / press line",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "e.g. \"Voted #1 lip gloss brand — Vogue Arabia\". Leave blank to hide."
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Press/award logo (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (social proof)",
      "blocks": [
        { "type": "rating" },
        { "type": "heading" },
        { "type": "cta_button" },
        { "type": "cta_button" },
        { "type": "trust_badge" }
      ]
    }
  ]
}
{% endschema %}
