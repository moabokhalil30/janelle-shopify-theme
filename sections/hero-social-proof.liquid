{{ 'section-hero-social-proof.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
    assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
  endif

  assign has_cta = false
  for block in section.blocks
    if block.type == 'cta_button' and block.settings.label != blank
      assign has_cta = true
      break
    endif
  endfor
-%}

{%- if section.settings.hero_height == 'adapt' and has_image -%}
  {%- style -%}
    #HeroSP-{{ section.id }} {
      aspect-ratio: {{ section.settings.image.aspect_ratio }};
    }
  {%- endstyle -%}
{%- endif -%}

<div
  id="HeroSP-{{ section.id }}"
  class="hero-social-proof hero-social-proof--{{ section.settings.hero_height }} hero-social-proof--align-{{ section.settings.content_position }} hero-social-proof--panel-{{ section.settings.text_panel }}"
  style="--hero-focal: {{ section.settings.focal_point }};"
>
  <div class="hero-social-proof__media{% unless has_image %} hero-social-proof__media--placeholder{% endunless %}">
    {%- if has_image -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          fetchpriority: fetch_priority
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if section.settings.image_overlay_opacity > 0 -%}
    <div
      class="hero-social-proof__overlay"
      style="opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};"
    ></div>
  {%- endif -%}

  {%- if section.settings.show_scrim -%}
    <div class="hero-social-proof__scrim"></div>
  {%- endif -%}

  <div class="hero-social-proof__content">
    <div class="hero-social-proof__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'rating' -%}
            {%- comment -%}
              Requires the text: stars on their own would imply a rating with
              nothing to back it up. Fill the social proof line and they appear.
            {%- endcomment -%}
            {%- if block.settings.rating_text != blank -%}
              {%- liquid
                assign star_pct = block.settings.rating | times: 20
                capture star_row
                  for i in (1..5)
                    echo '<svg class="hero-social-proof__star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 1.5l3.09 6.26 6.91 1-5 4.87 1.18 6.87L12 17.27l-6.18 3.23L7 13.63l-5-4.87 6.91-1z"/></svg>'
                  endfor
                endcapture
              -%}
              <div class="hero-social-proof__proof" {{ block.shopify_attributes }}>
                {%- if block.settings.show_stars -%}
                  <span
                    class="hero-social-proof__stars"
                    style="--hero-star-color: {{ block.settings.star_color }}; --hero-star-pct: {{ star_pct }}%;"
                    role="img"
                    aria-label="{{ block.settings.rating }} {{ 'accessibility.star_reviews_info' | t: rating_max: 5 | default: 'out of 5 stars' }}"
                  >
                    <span class="hero-social-proof__stars-row hero-social-proof__stars-row--track" aria-hidden="true">
                      {{- star_row -}}
                    </span>
                    <span class="hero-social-proof__stars-row hero-social-proof__stars-row--fill" aria-hidden="true">
                      {{- star_row -}}
                    </span>
                  </span>
                {%- endif -%}
                {%- if block.settings.rating_text != blank -%}
                  <span class="hero-social-proof__proof-text">{{ block.settings.rating_text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2
                class="hero-social-proof__heading {{ block.settings.heading_size }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}

      {%- if has_cta -%}
        <div class="hero-social-proof__ctas">
          {%- for block in section.blocks -%}
            {%- if block.type == 'cta_button' and block.settings.label != blank -%}
              <a
                {% if block.settings.link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.link }}"
                {% endif %}
                class="hero-social-proof__cta{% if block.settings.style_secondary %} hero-social-proof__cta--secondary{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="hero-social-proof__cta-label">
                  {{- block.settings.label | escape -}}
                  <span class="hero-social-proof__cta-caret">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </span>
                {%- if block.settings.thumbnail != blank -%}
                  <span class="hero-social-proof__cta-thumb">
                    {{
                      block.settings.thumbnail
                      | image_url: width: 144
                      | image_tag: width: 72, height: 72, loading: 'lazy', alt: ''
                    }}
                  </span>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_badge' -%}
          {%- if block.settings.text != blank or block.settings.logo != blank -%}
            <div class="hero-social-proof__badge" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
              {%- if block.settings.logo != blank -%}
                {{
                  block.settings.logo
                  | image_url: width: 300
                  | image_tag:
                    class: 'hero-social-proof__badge-logo',
                    widths: '100, 150, 200, 300',
                    loading: 'lazy',
                    alt: ''
                }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero (social proof)",
  "tag": "section",
  "class": "section section-hero-social-proof",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "hero_height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "medium",
      "label": "Hero height"
    },
    {
      "type": "select",
      "id": "text_panel",
      "options": [
        { "value": "light", "label": "Light panel behind text" },
        { "value": "dark", "label": "Dark panel behind text" },
        { "value": "none", "label": "No panel (text straight on photo)" }
      ],
      "default": "light",
      "label": "Text background",
      "info": "A panel keeps the text readable on any photo. 'No panel' only works on dark, simple images — pale or busy photos make the text very hard to read."
    },
    {
      "type": "select",
      "id": "focal_point",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center", "label": "Centre" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center",
      "label": "Image focal point",
      "info": "Which part of the photo stays visible when it gets cropped. Tall portrait photos crop a lot on desktop — use this to keep the face in frame."
    },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        { "value": "bottom", "label": "Bottom" },
        { "value": "middle", "label": "Middle" }
      ],
      "default": "bottom",
      "label": "Content position"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image overlay darkness",
      "info": "Darkens the whole image. Raise this if the text is hard to read.",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_scrim",
      "default": true,
      "label": "Fade bottom of image",
      "info": "Adds a soft dark fade behind the text so it stays readable."
    }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "Stars & social proof",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_stars",
          "default": true,
          "label": "Show stars"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": 5,
          "label": "Stars filled",
          "info": "Supports part-filled stars, e.g. 4.8."
        },
        {
          "type": "color",
          "id": "star_color",
          "default": "#f5d5e6",
          "label": "Star colour"
        },
        {
          "type": "inline_richtext",
          "id": "rating_text",
          "label": "Social proof line",
          "info": "e.g. Loved by <b>3,000+</b> happy customers. Use bold on the number. Leave blank to hide the whole line."
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ],
          "default": "h1",
          "label": "Heading size"
        }
      ]
    },
    {
      "type": "cta_button",
      "name": "CTA button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Shop all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "style_secondary",
          "default": false,
          "label": "Use outlined style",
          "info": "Tick this on your second button so the main one stands out."
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail (optional)",
          "info": "Small square product photo shown on the right of the button."
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge / press line",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "e.g. a press mention or award line. Leave blank to hide."
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Press / award logo (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (social proof)",
      "blocks": [
        { "type": "rating" },
        { "type": "heading" },
        { "type": "cta_button" },
        { "type": "cta_button" },
        { "type": "trust_badge" }
      ]
    }
  ]
}
{% endschema %}
