                              <div
                                id="Slide-{{ block.id }}-{{ forloop.index }}"
                                class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide"
                                tabindex="-1"
                                role="group"
                                {% if number_of_slides > 1 %}
                                  aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                  aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                {% endif %}
                              >
                                <ul class="list-unstyled" role="list">
                                  {%- for product in recommendations.products
                                    limit: block.settings.products_per_page
                                    offset: continue
                                  -%}
                                    <li>
                                      {%- if block.settings.enable_quick_add -%}
                                        {% assign quick_add = 'standard' %}
                                      {%- else -%}
                                        {% assign quick_add = 'none' %}
                                      {%- endif -%}
                                      {% render 'card-product',
                                        card_product: product,
                                        media_aspect_ratio: block.settings.image_ratio,
                                        show_secondary_image: false,
                                        lazy_load: false,
                                        skip_styles: skip_card_product_styles,
                                        quick_add: quick_add,
                                        section_id: section.id,
                                        horizontal_class: true,
                                        horizontal_quick_add: true
                                      %}
                                    </li>
                                    {%- assign skip_card_product_styles = true -%}
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endfor -%}
                          </div>
                          {%- if number_of_slides > 1 -%}
                            <div class="slider-buttons">
                              <button
                                type="button"
                                class="slider-button slider-button--prev"
                                name="previous"
                                aria-label="{{ 'general.slider.previous_slide' | t }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-caret.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <div class="slider-counter slider-counter--{{ block.settings.pagination_style }}{% if block.settings.pagination_style == 'counter' or block.settings.pagination_style == 'numbers' %} caption{% endif %}">
                                {%- if block.settings.pagination_style == 'counter' -%}
                                  <span class="slider-counter--current">1</span>
                                  <span aria-hidden="true"> / </span>
                                  <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                                  <span class="slider-counter--total">{{ number_of_slides }}</span>
                                {%- else -%}
                                  <div class="slideshow__control-wrapper">
                                    {%- for i in (1..number_of_slides) -%}
                                      <button
                                        class="slider-counter__link slider-counter__link--{{ block.settings.pagination_style }} link"
                                        aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                        aria-controls="Slider-{{ block.id }}"
                                      >
                                        {%- if block.settings.pagination_style == 'numbers' -%}
                                          {{ forloop.index -}}
                                        {%- else -%}
                                          <span class="dot"></span>
                                        {%- endif -%}
                                      </button>
                                    {%- endfor -%}
                                  </div>
                                {%- endif -%}
                              </div>
                              <button
                                type="button"
                                class="slider-button slider-button--next"
                                name="next"
                                aria-label="{{ 'general.slider.next_slide' | t }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-caret.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </div>
                          {%- endif -%}
                        </slideshow-component>
                        {%- if block.settings.make_collapsible_row -%}
                          </details>
                        {%- endif -%}
                      </div>
                    </aside>
                  {%- endif -%}
                  {{ 'component-card.css' | asset_url | stylesheet_tag }}
                  {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                  {%- if block.settings.enable_quick_add -%}
                    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
                    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                  {%- endif -%}
                </product-recommendations>
              {%- when 'icon-with-text' -%}
                {% render 'icon-with-text', block: block %}

              {%- comment -%} ===== Janelle custom PDP blocks ===== {%- endcomment -%}
              {%- when 'featured_review' -%}
                {%- assign fr_id = 'fr-' | append: block.id -%}
                {%- liquid
                  # Per-product overrides via metafields; fall back to the template defaults below.
                  assign fr_quote = product.metafields.custom.featured_review_quote.value | default: block.settings.quote
                  assign fr_author = product.metafields.custom.featured_review_author.value | default: block.settings.author
                  assign fr_rating = product.metafields.custom.featured_review_rating.value | default: block.settings.rating
                -%}
                {% style %}
                  .{{ fr_id }}{background:{{ block.settings.bg_color }};border-left:3px solid {{ block.settings.accent_color }};border-radius:{{ block.settings.corner_radius }}px;padding:1.4rem 1.6rem;margin:1.2rem 0;}
                  .{{ fr_id }}__label{font-size:1.1rem;letter-spacing:.1rem;text-transform:uppercase;color:{{ block.settings.accent_color }};margin-bottom:.5rem;}
                  .{{ fr_id }}__quote{font-style:italic;color:{{ block.settings.text_color }};font-size:1.5rem;line-height:1.45;}
                  .{{ fr_id }}__who{font-size:1.2rem;color:{{ block.settings.text_color }};opacity:.75;margin-top:.6rem;}
                  .{{ fr_id }}__stars{color:{{ block.settings.accent_color }};letter-spacing:.15rem;}
                {% endstyle %}
                <div class="{{ fr_id }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.label != blank -%}<div class="{{ fr_id }}__label">{{ block.settings.label }}</div>{%- endif -%}
                  <div class="{{ fr_id }}__quote">{{ fr_quote }}</div>
                  <div class="{{ fr_id }}__who">
                    {%- if block.settings.show_stars and fr_rating > 0 -%}<span class="{{ fr_id }}__stars">{% for i in (1..fr_rating) %}★{% endfor %}</span> {% endif -%}
                    {{ fr_author }}
                  </div>
                </div>

              {%- when 'benefit_bullets' -%}
                {%- assign bb_id = 'bb-' | append: block.id -%}
                {% style %}
                  .{{ bb_id }}{list-style:none;margin:1.2rem 0;padding:0;}
                  .{{ bb_id }} li{display:flex;gap:.8rem;align-items:flex-start;margin-bottom:.7rem;font-size:1.5rem;line-height:1.4;color:{{ block.settings.text_color }};}
                  .{{ bb_id }} .bb-ck{color:{{ block.settings.icon_color }};font-weight:700;flex:0 0 auto;}
                {% endstyle %}
                {%- assign usp_list = product.metafields.custom.usp_bullets.value -%}
                <ul class="{{ bb_id }}" {{ block.shopify_attributes }}>
                  {%- if usp_list != blank and usp_list.size > 0 -%}
                    {%- comment -%} Per-product USPs from the custom.usp_bullets list metafield. {%- endcomment -%}
                    {%- for bullet in usp_list -%}
                      {%- if bullet != blank -%}<li><span class="bb-ck">{{ block.settings.icon }}</span><span>{{ bullet }}</span></li>{%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- comment -%} Fallback: template-level bullets (shared across products). {%- endcomment -%}
                    {%- if block.settings.bullet_1 != blank -%}<li><span class="bb-ck">{{ block.settings.icon }}</span><span>{{ block.settings.bullet_1 }}</span></li>{%- endif -%}
                    {%- if block.settings.bullet_2 != blank -%}<li><span class="bb-ck">{{ block.settings.icon }}</span><span>{{ block.settings.bullet_2 }}</span></li>{%- endif -%}
                    {%- if block.settings.bullet_3 != blank -%}<li><span class="bb-ck">{{ block.settings.icon }}</span><span>{{ block.settings.bullet_3 }}</span></li>{%- endif -%}
                    {%- if block.settings.bullet_4 != blank -%}<li><span class="bb-ck">{{ block.settings.icon }}</span><span>{{ block.settings.bullet_4 }}</span></li>{%- endif -%}
                  {%- endif -%}
                </ul>

              {%- when 'social_proof' -%}
                {%- assign sp_id = 'sp-' | append: block.id -%}
                {% style %}
                  .{{ sp_id }}{display:inline-flex;align-items:center;gap:.6rem;font-size:1.3rem;color:{{ block.settings.text_color }};background:{{ block.settings.bg_color }};{% if block.settings.show_border %}border:1px solid {{ block.settings.border_color }};{% endif %}padding:.6rem 1.2rem;border-radius:2rem;margin:.6rem 0;}
                {% endstyle %}
                <div {{ block.shopify_attributes }}>
                  <span class="{{ sp_id }}">{%- if block.settings.icon != blank -%}{{ block.settings.icon }} {% endif -%}{{ block.settings.text }}</span>
                </div>

              {%- when 'trust_row' -%}
                {%- assign tr_id = 'tr-' | append: block.id -%}
                {% style %}
                  .{{ tr_id }}{display:flex;flex-wrap:wrap;gap:.8rem;margin:1.4rem 0;padding:1.2rem;background:{{ block.settings.bg_color }};border-radius:{{ block.settings.corner_radius }}px;}
                  .{{ tr_id }} .tr-item{flex:1 1 28%;min-width:9rem;text-align:center;font-size:1.2rem;line-height:1.3;color:{{ block.settings.text_color }};}
                  .{{ tr_id }} .tr-ic{font-size:2rem;display:block;margin-bottom:.4rem;}
                {% endstyle %}
                <div class="{{ tr_id }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.label_1 != blank -%}<div class="tr-item"><span class="tr-ic">{{ block.settings.icon_1 }}</span>{{ block.settings.label_1 }}</div>{%- endif -%}
                  {%- if block.settings.label_2 != blank -%}<div class="tr-item"><span class="tr-ic">{{ block.settings.icon_2 }}</span>{{ block.settings.label_2 }}</div>{%- endif -%}
                  {%- if block.settings.label_3 != blank -%}<div class="tr-item"><span class="tr-ic">{{ block.settings.icon_3 }}</span>{{ block.settings.label_3 }}</div>{%- endif -%}
                </div>

              {%- when 'guarantee' -%}
                {%- assign gt_id = 'gt-' | append: block.id -%}
                {% style %}
                  .{{ gt_id }}{text-align:{{ block.settings.alignment }};font-size:1.2rem;color:{{ block.settings.text_color }};margin:.4rem 0 1.2rem;}
                {% endstyle %}
                <div class="{{ gt_id }}" {{ block.shopify_attributes }}>{%- if block.settings.icon != blank -%}{{ block.settings.icon }} {% endif -%}{{ block.settings.text }}</div>

              {%- when 'kit_contents' -%}
                {%- assign kc_id = 'kc-' | append: block.id -%}
                {% style %}
                  .{{ kc_id }}__label{font-size:1.2rem;letter-spacing:.1rem;text-transform:uppercase;color:{{ block.settings.text_color }};opacity:.7;margin:1.2rem 0 .6rem;}
                  .{{ kc_id }}{display:flex;gap:1rem;margin:.4rem 0 1.2rem;}
                  .{{ kc_id }} .kc-item{flex:1;text-align:center;font-size:1.2rem;color:{{ block.settings.text_color }};}
                  .{{ kc_id }} .kc-ph{aspect-ratio:1/1;background:{{ block.settings.placeholder_color }};border-radius:6px;margin-bottom:.6rem;overflow:hidden;}
                  .{{ kc_id }} .kc-ph img{width:100%;height:100%;object-fit:cover;display:block;}
                  .{{ kc_id }} .kc-role{display:block;color:{{ block.settings.accent_color }};}
                {% endstyle %}
                <div {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}<div class="{{ kc_id }}__label">{{ block.settings.heading }}</div>{%- endif -%}
                  <div class="{{ kc_id }}">
                    {%- if block.settings.title_1 != blank -%}<div class="kc-item"><div class="kc-ph">{% if block.settings.image_1 %}{{ block.settings.image_1 | image_url: width: 300 | image_tag: loading: 'lazy' }}{% endif %}</div><strong>{{ block.settings.title_1 }}</strong><span class="kc-role">{{ block.settings.role_1 }}</span></div>{%- endif -%}
                    {%- if block.settings.title_2 != blank -%}<div class="kc-item"><div class="kc-ph">{% if block.settings.image_2 %}{{ block.settings.image_2 | image_url: width: 300 | image_tag: loading: 'lazy' }}{% endif %}</div><strong>{{ block.settings.title_2 }}</strong><span class="kc-role">{{ block.settings.role_2 }}</span></div>{%- endif -%}
                    {%- if block.settings.title_3 != blank -%}<div class="kc-item"><div class="kc-ph">{% if block.settings.image_3 %}{{ block.settings.image_3 | image_url: width: 300 | image_tag: loading: 'lazy' }}{% endif %}</div><strong>{{ block.settings.title_3 }}</strong><span class="kc-role">{{ block.settings.role_3 }}</span></div>{%- endif -%}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
          <a href="{{ product.url }}" class="link product__view-details animate-arrow">
            {{ 'products.product.view_full_details' | t }}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </a>
        </section>
      </div>
    </div>

    {% render 'product-media-modal', hidden_variant_images: hidden_variant_images %}

    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
        <div
          role="dialog"
          aria-label="{{ block.settings.text }}"
          aria-modal="true"
          class="product-popup-modal__content"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ block.id }}"
            type="button"
            class="product-popup-modal__toggle"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div class="product-popup-modal__content-info">
            <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
            {{ block.settings.page.content }}
          </div>
        </div>
      </modal-dialog>
    {%- endfor -%}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}

    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </div>
</product-info>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "t:sections.main-product.blocks.text.settings.text.default",
          "label": "t:sections.main-product.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__2.label"
            },
            {
              "value": "uppercase",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__3.label"
            }
          ],
          "default": "body",
          "label": "t:sections.main-product.blocks.text.settings.text_style.label"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.main-product.blocks.title.name",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.main-product.blocks.price.name",
      "limit": 1
    },
    {
      "type": "complete_look",
      "name": "Complete the look",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "One line under Add to cart: on a gloss it suggests the matching liner shade, on the liner the matching gloss. One tap adds it."
        },
        {
          "type": "product",
          "id": "liner",
          "label": "Liner product"
        },
        {
          "type": "product",
          "id": "gloss",
          "label": "Gloss to suggest on the liner page"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Text on gloss pages",
          "default": "Complete the look: matching shade"
        },
        {
          "type": "text",
          "id": "liner_label",
          "label": "Text on the liner page",
          "default": "Complete the look: matching gloss"
        },
        {
          "type": "text",
          "id": "added_label",
          "label": "Added message",
          "default": "Added ✓"
        },
        {
          "type": "textarea",
          "id": "pairs",
          "label": "Shade pairings",
          "info": "One per line: Gloss shade=Liner shade. Add a backup after | in case the first is sold out.",
          "default": "Creamy Latte=08 Nude|01 Brunette"
        },
        {
          "type": "header",
          "content": "Kits, bags and other products"
        },
        {
          "type": "textarea",
          "id": "product_rules",
          "label": "Product suggestions",
          "info": "One per line: product-handle=suggested-handle. Add :Shade to pick a shade, e.g. keychain=lip-gloss-squeeze-tube:Barbie Dreams. Kits with a shade picker open their page instead of adding.",
          "default": "lip-kit-bundle=the-beauty-bag\niconic-lip-trio=the-beauty-bag\nthe-minis=mini-beauty-bag\nthe-beauty-bag=lip-kit-bundle\nmini-beauty-bag=the-minis\nkeychain=lip-gloss-squeeze-tube:Barbie Dreams"
        },
        {
          "type": "text",
          "id": "rule_label",
          "label": "Text for these suggestions",
          "default": "Complete the look:"
        },
        {
          "type": "text",
          "id": "build_label",
          "label": "Link text for kits",
          "default": "Build yours →"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text colour",
          "default": "#b9648a"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border colour",
          "default": "#efcbdb"
        }
      ]
    },
    {
      "type": "free_shipping_note",
      "name": "Free shipping message",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows how much more to add for free shipping. Text, amount and colours are in Theme settings → Free shipping bar."
        }
      ]
    },
    {
      "type": "shade_finder",
      "name": "Shade finder",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Big round shade swatches with names, plus shade-family filters. Families are matched on the shade name and its Shade description."
        },
        {
          "type": "range",
