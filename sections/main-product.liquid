<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {%- liquid
    comment
      Builds hidden_variant_images: the media srcs the gallery should suppress
      for the currently selected variant. Both snippets that render media
      (product-media-gallery and product-media-modal) already consume this
      list, so the contract is unchanged and neither snippet needs editing.

      Two strategies:

      1. variant_media_grouping OFF (default, and what every builder template
         uses) - the stock Dawn rule. Hide images attached to OTHER variants;
         every unattached image stays visible on all variants.

      2. variant_media_grouping ON - positional grouping. Each variant's
         attached image opens that variant's group, and every following media
         item belongs to that group until the next variant's attached image.
         Only the selected variant's group survives.

      Strategy 2 is opt-in per template so enabling it on the default product
      template cannot alter how the builder templates render.
    endcomment

    assign selected_variant = product.selected_or_first_available_variant
    assign variant_attached_images = product.images | where: 'attached_to_variant?', true
    assign hidden_variant_images = ''

    assign use_media_grouping = false
    if section.settings.variant_media_grouping and variant_attached_images.size > 0
      if selected_variant.featured_image.src != blank
        assign use_media_grouping = true
      endif
    endif

    if use_media_grouping
      comment
        Group boundaries are the variant-attached image srcs, in product media
        order. Media with no src (video, 3D) never opens a group and simply
        stays with the group it sits inside.
      endcomment
      assign group_start_srcs = ''
      for img in variant_attached_images
        assign group_start_srcs = group_start_srcs | append: img.src | append: '|'
      endfor
      assign group_start_srcs = group_start_srcs | split: '|'

      assign inside_selected_group = false
      assign selected_group_size = 0

      for media in product.media
        if media.src != blank and group_start_srcs contains media.src
          if media.src == selected_variant.featured_image.src
            assign inside_selected_group = true
          else
            assign inside_selected_group = false
          endif
        endif

        unless inside_selected_group
          if media.src != blank
            assign hidden_variant_images = hidden_variant_images | append: media.src | append: '|'
          endif
        endunless

        if inside_selected_group
          assign selected_group_size = selected_group_size | plus: 1
        endif
      endfor

      comment
        Safety net: if grouping resolved to an empty gallery (media ordered so
        that the selected variant's image never opens a group, for instance),
        fall back to showing everything rather than rendering nothing.
      endcomment
      if selected_group_size == 0
        assign hidden_variant_images = ''
      endif
    else
      for img in variant_attached_images
        assign belongs_to_selected_variant = false
        for img_variant in img.variants
          if img_variant.id == selected_variant.id
            assign belongs_to_selected_variant = true
          endif
        endfor
        unless belongs_to_selected_variant
          assign hidden_variant_images = hidden_variant_images | append: img.src | append: '|'
        endunless
      endfor
    endif

    assign hidden_variant_images = hidden_variant_images | split: '|'
  -%}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">
        {% render 'product-media-gallery', hidden_variant_images: hidden_variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%- when 'title' -%}
                <div class="product__title" {{ block.shopify_attributes }}>
                  <h1>{{ product.title | escape }}</h1>
                  <a href="{{ product.url }}" class="product__title">
                    <h2 class="h1">
                      {{ product.title | escape }}
                    </h2>
                  </a>
                </div>
              {%- when 'price' -%}
                <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                  {%- render 'price',
                    product: product,
                    use_variant: true,
                    show_badges: true,
                    price_class: 'price--large'
                  -%}
                </div>
                {%- if product.quantity_price_breaks_configured? -%}
                  <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                    <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                  </div>
                {%- endif -%}
                {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                  <div class="product__tax caption rte">
                    {%- if cart.duties_included and cart.taxes_included -%}
                      {{ 'products.product.duties_and_taxes_included' | t }}
                    {%- elsif cart.taxes_included -%}
                      {{ 'products.product.taxes_included' | t }}
                    {%- elsif cart.duties_included -%}
                      {{ 'products.product.duties_included' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div {{ block.shopify_attributes }}>
                  {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                  {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    {{ form | payment_terms }}
                  {%- endform -%}
                </div>
              {%- when 'inventory' -%}
                <p
                  class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                  {{ block.shopify_attributes }}
                  id="Inventory-{{ section.id }}"
                  role="status"
                >
                  {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity
                          <= block.settings.inventory_threshold
                      -%}
                        <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_low_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_low_stock' | t -}}
                        {%- endif -%}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_in_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_in_stock' | t -}}
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                </p>
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}
              {%- when 'sku' -%}
                <p
                  class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                  id="Sku-{{ section.id }}"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                  {{- product.selected_or_first_available_variant.sku -}}
                </p>
              {%- when 'complete_look' -%}
                {%- comment -%}
                  One-line upsell under Add to cart: on a gloss it suggests the matching liner shade,
                  on the liner the matching gloss (from the pairing list). One tap adds the suggestion.
                  Ported from Concept 3 "c3-complete-look".
                {%- endcomment -%}
                  <style>
                    .complete-look { margin: .8rem 0 0; }
                    .complete-look__btn { text-decoration: none;
                      
                      display: flex; align-items: center; gap: 1rem; width: 100%; padding: 1.1rem 1.4rem;
                      border: 1px solid {{ block.settings.border_color }}; border-radius: .8rem; background: #fff;
                      color: {{ block.settings.text_color }}; font-family: inherit; font-size: 1.35rem; text-align: left; cursor: pointer;
                      transition: border-color .2s;
                    }
                    .complete-look__btn:hover { border-color: {{ block.settings.text_color }}; }
                    .complete-look__btn[aria-busy='true'] { opacity: .6; pointer-events: none; }
                    .complete-look__plus { font-size: 1.8rem; line-height: 1; font-weight: 700; }
                    .complete-look__dot { flex: 0 0 auto; width: 2.6rem; height: 2.6rem; border-radius: 50%; background-size: cover; background-position: center; box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }
                    .complete-look__text { flex: 1; min-width: 0; line-height: 1.3; }
                    .complete-look__text strong { font-weight: 700; }
                    .complete-look__price { white-space: nowrap; font-weight: 700; }
                  </style>
                {%- liquid
                  assign cl_liner = block.settings.liner
                  assign cl_gloss = block.settings.gloss
                  assign cl_suggest = blank
                  assign cl_is_liner = false
                  if cl_liner != blank and cl_gloss != blank and product.has_only_default_variant == false
                    if product.id == cl_liner.id
                      assign cl_suggest = cl_gloss
                      assign cl_is_liner = true
                    elsif product.options.first == 'Color'
                      assign cl_suggest = cl_liner
                    endif
                  endif
                -%}
                {%- comment -%}
                  Product rules (kits, bags, keychain): "page-handle=suggested-handle" or
                  "page-handle=suggested-handle:Preferred shade". Kits built with the shade picker
                  can't be added without their shades, so those open the kit page instead.
                {%- endcomment -%}
                {%- liquid
                  assign pr_target = blank
                  assign pr_shade = ''
                  assign pr_lines = block.settings.product_rules | newline_to_br | split: '<br />'
                  for pr_line in pr_lines
                    assign pr_parts = pr_line | strip | split: '='
                    if pr_parts.size == 2 and pr_parts[0] == product.handle
                      assign pr_right = pr_parts[1] | split: ':'
                      assign pr_target = all_products[pr_right[0]]
                      if pr_right.size > 1
                        assign pr_shade = pr_right[1] | strip
                      endif
                    endif
                  endfor
                -%}
                {%- if pr_target != blank and pr_target.available -%}
                  {%- liquid
                    assign pr_variant = pr_target.first_available_variant
                    for v in pr_target.variants
                      if v.title == pr_shade and v.available
                        assign pr_variant = v
                      endif
                    endfor
                    assign pr_is_kit = false
                    if pr_target.template_suffix contains 'builder' or pr_target.template_suffix contains 'aov'
                      assign pr_is_kit = true
                    endif
                    assign pr_img = pr_variant.featured_image | default: pr_target.featured_image
                  -%}
                  <div class="complete-look" {{ block.shopify_attributes }}>
                    {%- if pr_is_kit -%}
                      <a class="complete-look__btn" href="{{ pr_target.url }}">
                        <span class="complete-look__plus" aria-hidden="true">+</span>
                        <span class="complete-look__dot" style="background-image:url('{{ pr_img | image_url: width: 80 }}')"></span>
                        <span class="complete-look__text">{{ block.settings.rule_label }} <strong>{{ pr_target.title | downcase | capitalize }}</strong></span>
                        <span class="complete-look__price">{{ block.settings.build_label }}</span>
                      </a>
                    {%- else -%}
                      <button type="button" class="complete-look__btn" data-look-fixed="{{ pr_variant.id }}">
                        <span class="complete-look__plus" aria-hidden="true">+</span>
                        <span class="complete-look__dot" style="background-image:url('{{ pr_img | image_url: width: 80 }}')"></span>
                        <span class="complete-look__text">
                          {{ block.settings.rule_label }} <strong>{{ pr_target.title | downcase | capitalize }}</strong>
                          {%- unless pr_target.has_only_default_variant %} · {{ pr_variant.title }}{% endunless -%}
                        </span>
                        <span class="complete-look__price">+{{ pr_variant.price | money_without_trailing_zeros }}</span>
                      </button>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if cl_suggest != blank -%}
                  <div class="complete-look" id="CompleteLook-{{ section.id }}" {{ block.shopify_attributes }} hidden>
                    <button type="button" class="complete-look__btn" data-look-add>
                      <span class="complete-look__plus" aria-hidden="true">+</span>
                      <span class="complete-look__dot" data-look-dot></span>
                      <span class="complete-look__text">
                        {% if cl_is_liner %}{{ block.settings.liner_label }}{% else %}{{ block.settings.label }}{% endif %}
                        <strong data-look-name></strong>
                      </span>
                      <span class="complete-look__price" data-look-price></span>
                    </button>
                  </div>
                  <script type="application/json" data-look-config="{{ section.id }}">
                    {
                      "isLinerPage": {{ cl_is_liner }},
                      "variants": {
                        {%- for v in product.variants -%}
                          "{{ v.id }}": {{ v.title | json }}{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                      },
                      "start": {{ product.selected_or_first_available_variant.id | json }},
                      "suggest": [
                        {%- for v in cl_suggest.variants -%}
                          { "id": {{ v.id }}, "name": {{ v.title | json }}, "price": {{ v.price }}, "available": {{ v.available }},
                            "img": {{ v.featured_image | default: cl_suggest.featured_image | image_url: width: 80 | json }} }{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                      ],
                      "pairs": {{ block.settings.pairs | json }},
                      "moneyFormat": {{ shop.money_format | json }},
                      "added": {{ block.settings.added_label | json }}
                    }
                  </script>
                  <script>
                    (() => {
                      const root = document.getElementById('CompleteLook-{{ section.id }}');
                      const config = JSON.parse(document.querySelector('[data-look-config="{{ section.id }}"]').textContent);
                      const pairs = {};
                      config.pairs.split(/\n|;/).forEach((line) => {
                        const p = line.split('=');
                        if (p.length < 2) return;
                        const gloss = p[0].trim();
                        const liners = p[1].split('|').map((s) => s.trim());
                        if (config.isLinerPage) liners.forEach((l) => (pairs[l] = pairs[l] || []).push(gloss));
                        else pairs[gloss] = liners;
                      });
                      const money = (c) => config.moneyFormat.replace(/\{\{\s*amount[a-z_]*\s*\}\}/, (c / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')).replace(/\.00(?!\d)/, '');
                      let pick = null;
                      const render = (variantId) => {
                        const title = config.variants[variantId];
                        const wanted = pairs[title] || [];
                        pick = wanted.map((n) => config.suggest.find((s) => s.name === n && s.available)).find(Boolean) || null;
                        root.hidden = !pick;
                        if (!pick) return;
                        root.querySelector('[data-look-name]').textContent = pick.name;
                        root.querySelector('[data-look-price]').textContent = '+' + money(pick.price);
                        root.querySelector('[data-look-dot]').style.backgroundImage = 'url(' + pick.img + ')';
                      };
                      root.querySelector('[data-look-add]').addEventListener('click', async (e) => {
                        if (!pick) return;
                        const btn = e.currentTarget;
                        btn.setAttribute('aria-busy', 'true');
                        const cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
                        const body = { items: [{ id: pick.id, quantity: 1 }] };
                        if (cart && cart.getSectionsToRender) {
                          body.sections = cart.getSectionsToRender().map((s) => s.id);
                          body.sections_url = window.location.pathname;
                        }
                        try {
                          const res = await fetch(((window.routes && window.routes.cart_add_url) || '/cart/add') + '.js', {
                            method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body),
                          });
                          const data = await res.json();
                          if (!res.ok || data.status) throw new Error(data.description || 'Could not add');
                          if (cart && cart.renderContents && data.sections) {
                            cart.classList.contains('is-empty') && cart.classList.remove('is-empty');
                            cart.renderContents(Object.assign({}, data.items ? data.items[0] : data, { sections: data.sections }));
                          }
                          if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') publish(PUB_SUB_EVENTS.cartUpdate, { source: 'complete-look' });
                        } catch (err) {
                          root.querySelector('[data-look-price]').textContent = err.message;
                        } finally {
                          btn.removeAttribute('aria-busy');
                        }
                      });
                      document.addEventListener('DOMContentLoaded', () => {
                        if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
                          subscribe(PUB_SUB_EVENTS.variantChange, (evt) => { const v = evt && evt.data && evt.data.variant; if (v) render(v.id); });
                        }
                      });
                      render(config.start);
                    })();
                  </script>
                {%- endif -%}
                <script>
                  (() => {
                    document.querySelectorAll('#shopify-section-{{ section.id }} [data-look-fixed]').forEach((btn) => {
                      if (btn.dataset.bound) return;
                      btn.dataset.bound = '1';
                      btn.addEventListener('click', async () => {
                        btn.setAttribute('aria-busy', 'true');
                        const cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
                        const body = { items: [{ id: Number(btn.dataset.lookFixed), quantity: 1 }] };
                        if (cart && cart.getSectionsToRender) { body.sections = cart.getSectionsToRender().map((x) => x.id); body.sections_url = window.location.pathname; }
                        try {
                          const res = await fetch(((window.routes && window.routes.cart_add_url) || '/cart/add') + '.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) });
                          const data = await res.json();
                          if (!res.ok || data.status) throw new Error(data.description || 'Could not add');
                          if (cart && cart.renderContents && data.sections) { cart.classList.remove('is-empty'); cart.renderContents(Object.assign({}, data.items ? data.items[0] : data, { sections: data.sections })); }
                          if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') publish(PUB_SUB_EVENTS.cartUpdate, { source: 'complete-look' });
                        } catch (err) {
                          btn.querySelector('.complete-look__price').textContent = err.message;
                        } finally { btn.removeAttribute('aria-busy'); }
                      });
                    });
                  })();
                </script>
              {%- when 'free_shipping_note' -%}
                <div class="product__free-ship" {{ block.shopify_attributes }} style="margin: 1.2rem 0 .4rem;">
                  {% render 'free-shipping-progress', compact: true, show_empty: true, plain: true %}
                </div>
              {%- when 'shade_finder' -%}
                {%- comment -%}
                  Turns the shade swatches into big round swatches with the name underneath,
                  and adds shade-family chips (matched on shade name + shade description).
                  The theme redraws the picker on every shade change, so the chips re-attach.
                {%- endcomment -%}
                {%- liquid
                  assign sf_root = '#shopify-section-' | append: section.id
                  assign sf_size = block.settings.swatch_size
                -%}
                <style>
                  {{ sf_root }} .product-form__input--swatch { display: flex; flex-wrap: wrap; gap: 1.4rem .2rem; }
                  {{ sf_root }} .product-form__input--swatch .form__label { width: 100%; margin-bottom: .4rem; }
                  {{ sf_root }} .product-form__input--swatch .swatch-input__label {
                    --swatch-input--size: {{ sf_size }}px;
                    display: inline-flex; flex-direction: column; align-items: center; gap: .6rem;
                    width: calc({{ sf_size }}px + 2.2rem); margin: 0 !important; padding: .4rem 0 0;
                    border-radius: 0; outline: none !important; box-shadow: none !important;
                  }
                  {{ sf_root }} .product-form__input--swatch .swatch-input__label > .swatch {
                    --swatch--border-radius: 50%; border-radius: 50%;
                    outline: 2px solid transparent; outline-offset: 3px; transition: outline-color .2s, transform .2s;
                  }
                  {{ sf_root }} .product-form__input--swatch .swatch-input__label:hover > .swatch { transform: scale(1.05); }
                  {{ sf_root }} .product-form__input--swatch .swatch-input__label::after {
                    content: attr(title); font-size: 1.05rem; font-weight: 400; line-height: 1.2; letter-spacing: .02rem;
                    text-align: center; color: {{ block.settings.name_color }};
                  }
                  {{ sf_root }} .product-form__input--swatch .swatch-input__input:checked + .swatch-input__label > .swatch { outline-color: {{ block.settings.accent_color }}; }
                  {{ sf_root }} .product-form__input--swatch .swatch-input__input:checked + .swatch-input__label::after { font-weight: 700; color: {{ block.settings.accent_color }}; }
                  /* Sold out: theme's own cross on the circle; name faded but not struck through. */
                  {{ sf_root }} .product-form__input--swatch .swatch-input__input.visually-disabled + .swatch-input__label::after,
                  {{ sf_root }} .product-form__input--swatch .swatch-input__input:disabled + .swatch-input__label::after { opacity: .55; text-decoration: none; }
                  {{ sf_root }} .product-form__input--swatch .swatch-input__label.is-filtered-out { display: none; }
                  {{ sf_root }} .shade-finder__chips { display: flex; flex-wrap: wrap; gap: .6rem; width: 100%; margin: .2rem 0 .8rem; }
                  {{ sf_root }} .shade-finder__chip {
                    padding: .8rem 1.4rem; border: 1px solid {{ block.settings.chip_color }}; border-radius: 999px;
                    background: #fff; color: {{ block.settings.name_color }};
                    font-family: inherit; font-size: 1.3rem; font-weight: 700; line-height: 1; letter-spacing: .04rem; cursor: pointer;
                  }
                  {{ sf_root }} .shade-finder__chip[aria-pressed='true'] { border-color: {{ block.settings.accent_color }}; background: {{ block.settings.chip_color }}; color: {{ block.settings.accent_color }}; }
                  @media screen and (max-width: 749px) {
                    {{ sf_root }} .product-form__input--swatch { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem .4rem; }
                    {{ sf_root }} .product-form__input--swatch .form__label,
                    {{ sf_root }} .shade-finder__chips { grid-column: 1 / -1; }
                    {{ sf_root }} .product-form__input--swatch .swatch-input__label { --swatch-input--size: min({{ sf_size | times: 1.08 | round }}px, 16vw); width: auto; }
                  }
                </style>

                {%- capture sf_descriptions -%}
                  {
                  {%- for v in product.variants -%}
                    {{ v.option1 | json }}: {{ v.metafields.custom.shade_description.value | default: '' | json }}{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                  }
                {%- endcapture -%}
                <script type="application/json" data-shade-finder="{{ section.id }}" {{ block.shopify_attributes }}>
                  {
                    "descriptions": {{ sf_descriptions }},
                    "families": [
                      { "label": {{ block.settings.family_nude | json }}, "test": "nude|brown|latte|mocha|chocolate|honey|terracotta|peach|caramel|espresso" },
                      { "label": {{ block.settings.family_pink | json }}, "test": "pink|rose|mauve|blush" },
                      { "label": {{ block.settings.family_red | json }}, "test": "red|ruby|berry|wine|maroon" },
                      { "label": {{ block.settings.family_sheer | json }}, "test": "sheer|transparent|glitter|shimmer|clear" }
                    ],
                    "all": {{ block.settings.family_all | json }}
                  }
                </script>
                <script>
                  (() => {
                    const root = document.getElementById('shopify-section-{{ section.id }}');
                    const config = JSON.parse(document.querySelector('[data-shade-finder="{{ section.id }}"]').textContent);
                    const families = config.families.map((f) => ({ label: f.label, test: new RegExp(f.test, 'i') }));
                    let active = 0;

                    const matches = (family, input) => !family || family.test.test(input.value + ' ' + (config.descriptions[input.value] || ''));

                    const apply = (fieldset, chosen) => {
                      fieldset.querySelectorAll('.swatch-input__input').forEach((input) => {
                        input.nextElementSibling?.classList.toggle('is-filtered-out', !matches(chosen, input));
                      });
                    };

                    const init = () => {
                      const fieldset = root.querySelector('.product-form__input--swatch');
                      if (!fieldset || fieldset.querySelector('.shade-finder__chips')) return;
                      const inputs = [...fieldset.querySelectorAll('.swatch-input__input')];
                      const used = families.filter((f) => inputs.some((i) => matches(f, i)));
                      if (used.length < 2) return;
                      const options = [null, ...used];
                      if (active >= options.length) active = 0;

                      const bar = document.createElement('div');
                      bar.className = 'shade-finder__chips';
                      bar.setAttribute('role', 'group');
                      bar.setAttribute('aria-label', 'Shade family');
                      options.forEach((family, i) => {
                        const chip = document.createElement('button');
                        chip.type = 'button';
                        chip.className = 'shade-finder__chip';
                        chip.textContent = family ? family.label : config.all;
                        chip.setAttribute('aria-pressed', i === active ? 'true' : 'false');
                        chip.addEventListener('click', () => {
                          active = i;
                          bar.querySelectorAll('.shade-finder__chip').forEach((c, j) => c.setAttribute('aria-pressed', j === i ? 'true' : 'false'));
                          apply(fieldset, family);
                        });
                        bar.appendChild(chip);
                      });
                      const legend = fieldset.querySelector('legend');
                      legend ? legend.after(bar) : fieldset.prepend(bar);
                      apply(fieldset, options[active]);
                    };

                    init();
                    // The picker is redrawn after each shade change; put the chips back.
                    new MutationObserver(init).observe(root, { childList: true, subtree: true });
                  })();
                </script>
              {%- when 'shade_description' -%}
                {%- assign shade_description = product.selected_or_first_available_variant.metafields.custom.shade_description.value -%}
                <p
                  class="product__shade-description{% if shade_description == blank %} hidden{% endif %}"
                  id="ShadeDescription-{{ section.id }}"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  {{- shade_description | escape | newline_to_br -}}
                </p>
                <style>
                  .product__shade-description {
                    margin: -0.6rem 0 1.2rem;
                    font-size: 1.15rem;
                    line-height: 1.4;
                    font-style: italic;
                    color: rgba(var(--color-foreground), 0.75);
                  }
                </style>
                <script>
                  // Swap in the picked shade's description when the variant changes.
                  document.addEventListener('DOMContentLoaded', () => {
                    if (typeof subscribe !== 'function' || typeof PUB_SUB_EVENTS === 'undefined') return;
                    subscribe(PUB_SUB_EVENTS.variantChange, ({ data }) => {
                      if (!data || data.sectionId !== '{{ section.id }}') return;
                      const source = data.html.getElementById('ShadeDescription-{{ section.id }}');
                      const destination = document.getElementById('ShadeDescription-{{ section.id }}');
                      if (!source || !destination) return;
                      destination.innerHTML = source.innerHTML;
                      destination.classList.toggle('hidden', source.classList.contains('hidden'));
                    });
                  });
                </script>
              {%- when 'custom_liquid' -%}
                {{ block.settings.custom_liquid }}
              {%- when 'collapsible_tab' -%}
                {%- liquid
                  # Per-product override for collapsible content. Prefer an explicit metafield key
                  # setting; otherwise map common headings to known product metafields. This keeps
                  # working even if the theme editor strips the optional metafield_key setting.
                  assign ct_key = block.settings.metafield_key
                  if ct_key == blank
                    assign ct_head = block.settings.heading | downcase
                    if ct_head contains 'how to'
                      assign ct_key = 'how_to_use'
                    elsif ct_head contains 'ingredient'
                      assign ct_key = 'ingredients'
                    elsif ct_head contains 'shade'
                      assign ct_key = 'shade_guide'
                    endif
                  endif
                  assign ct_mf = blank
                  if ct_key != blank
                    assign ct_mf = product.metafields.custom[ct_key]
                  endif
                -%}
                <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary>
                      <div class="summary__title">
                        {% render 'icon-accordion', icon: block.settings.icon %}
                        <h2 class="h4 accordion__title inline-richtext">
                          {{ block.settings.heading | default: block.settings.page.title | escape }}
                        </h2>
                      </div>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                      {%- if ct_mf != blank and ct_mf.value != blank -%}
                        {{ ct_mf.value | newline_to_br }}
                      {%- else -%}
                        {{ block.settings.content }}
                      {%- endif -%}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                </div>
              {%- when 'quantity_selector' -%}
