{% comment %}
  Product slider: heading + "shop more" link, then a sliding row of product cards.
  Each card has a rounded image with quick add / view icons, name, price and shade swatches.
  Choosing a shade swaps the image, price and the variant that quick add puts in the cart.
{% endcomment %}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.show_wishlist -%}
  {{ 'wishlist.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign section_id = section.id
  assign collection = section.settings.collection
  assign shop_more_link = section.settings.link | default: collection.url
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'tall'
      assign ratio = '4 / 5'
    else
      assign ratio = '3 / 4'
  endcase
-%}

{%- style -%}
  .product-slider-{{ section_id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .product-slider-{{ section_id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .product-slider-{{ section_id }} .product-slider__header {
    margin-bottom: 2rem;
  }

  .product-slider-{{ section_id }} .product-slider__heading {
    margin: 0;
  }

  .product-slider-{{ section_id }} .product-slider__more {
    display: inline-block;
    margin-top: 0.8rem;
    color: rgb(var(--color-foreground));
    font-size: 1.5rem;
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  .product-slider-{{ section_id }} .product-slider__track {
    --cards-visible: {{ section.settings.cards_mobile }};
    --card-gap: 1.2rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--cards-visible) - 1) * var(--card-gap)) / var(--cards-visible));
    gap: var(--card-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .product-slider-{{ section_id }} .product-slider__track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .product-slider-{{ section_id }} .product-slider__track {
      --cards-visible: {{ section.settings.cards_desktop }};
      --card-gap: 2rem;
    }
  }

  .product-slider-{{ section_id }} .product-slider__item {
    scroll-snap-align: start;
    min-width: 0;
  }

  .product-slider-{{ section_id }} .product-slider__media {
    position: relative;
    aspect-ratio: {{ ratio }};
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: rgba(var(--color-foreground), 0.04);
  }

  .product-slider-{{ section_id }} .product-slider__media-link,
  .product-slider-{{ section_id }} .product-slider__media img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-slider-{{ section_id }} .product-slider__media img {
    object-fit: cover;
    transition: opacity 0.25s ease;
  }

  .product-slider-{{ section_id }} .product-slider__badge {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    z-index: 1;
    padding: 0.4rem 1.2rem;
    border-radius: 999px;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1.2rem;
    line-height: 1.4;
    pointer-events: none;
  }

  .product-slider-{{ section_id }} .product-slider__badge[hidden] {
    display: none;
  }

  .product-slider-{{ section_id }} .product-slider__actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.2rem;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }

  .product-slider-{{ section_id }} .product-slider__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.8rem;
    height: 3.8rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: {{ section.settings.icon_background }};
    color: {{ section.settings.icon_color }};
    cursor: pointer;
    box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.12);
    transition: transform 0.2s ease;
  }

  .product-slider-{{ section_id }} .product-slider__action:hover {
    transform: scale(1.06);
  }

  .product-slider-{{ section_id }} .product-slider__action[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .product-slider-{{ section_id }} .product-slider__action svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .product-slider-{{ section_id }} .product-slider__action .loading__spinner {
    position: absolute;
    width: 1.8rem;
  }

  .product-slider-{{ section_id }} .product-slider__action.loading svg:not(.spinner) {
    visibility: hidden;
  }

  .product-slider-{{ section_id }} .product-slider__info {
    padding-top: 1.2rem;
  }

  .product-slider-{{ section_id }} .product-slider__title {
    display: block;
    margin: 0;
    color: rgb(var(--color-foreground));
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.3;
    text-decoration: none;
  }

  .product-slider-{{ section_id }} .product-slider__price {
    margin-top: 0.4rem;
    font-size: 1.5rem;
    color: rgba(var(--color-foreground), 0.85);
  }

  .product-slider-{{ section_id }} .product-slider__price s {
    margin-left: 0.6rem;
    color: rgba(var(--color-foreground), 0.5);
  }

  .product-slider-{{ section_id }} .product-slider__shades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .product-slider-{{ section_id }} .product-slider__shade,
  .product-slider-{{ section_id }} .product-slider__shade-more {
    position: relative;
    flex: 0 0 auto;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .product-slider-{{ section_id }} .product-slider__shade {
    border: 0.2rem solid #ffffff;
    outline: 0.1rem solid rgba(var(--color-foreground), 0.2);
    background-color: #f4f4f4;
    background-size: cover;
    background-position: center;
  }

  .product-slider-{{ section_id }} .product-slider__shade.is-selected {
    outline: 0.2rem solid rgb(var(--color-foreground));
  }

  .product-slider-{{ section_id }} .product-slider__shade[data-sold-out='true'] {
    opacity: 0.4;
  }

  .product-slider-{{ section_id }} .product-slider__shade[data-sold-out='true']::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(to top right, transparent calc(50% - 1px), #999999, transparent calc(50% + 1px));
  }

  .product-slider-{{ section_id }} .product-slider__shade-more {
    border: 0.1rem solid rgba(var(--color-foreground), 0.2);
    background: transparent;
    color: rgba(var(--color-foreground), 0.75);
    font-size: 1.1rem;
  }

  .product-slider-{{ section_id }} .product-slider__shade-extra:not([hidden]) {
    display: contents;
  }

  .product-slider-{{ section_id }} .product-slider__shade-name {
    margin: 0.6rem 0 0;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.7);
  }

  .product-slider-{{ section_id }} .product-slider__nav {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .product-slider-{{ section_id }} .product-slider__nav[hidden] {
    display: none;
  }

  .product-slider-{{ section_id }} .product-slider__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    padding: 0;
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-radius: 50%;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    cursor: pointer;
  }

  .product-slider-{{ section_id }} .product-slider__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .product-slider-{{ section_id }} .product-slider__arrow svg {
    width: 1.4rem;
    height: 1.4rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width product-slider-{{ section_id }}">
    <div class="product-slider__header">
      {%- if section.settings.title != blank -%}
        <h2 class="product-slider__heading inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.link_label != blank and shop_more_link != blank -%}
        <a href="{{ shop_more_link }}" class="product-slider__more">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    <ul class="product-slider__track" id="ProductSlider-{{ section_id }}" role="list">
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {%- liquid
          assign current_variant = product.selected_or_first_available_variant
          assign current_image = current_variant.featured_image | default: product.featured_media.preview_image
          assign single_option = false
          if product.options.size == 1
            assign single_option = true
          endif
          assign show_shades = false
          if section.settings.show_shades and single_option and product.variants.size > 1
            assign show_shades = true
          endif
          assign shade_limit = section.settings.shades_to_show
          assign form_id = 'ProductSliderForm-' | append: section_id | append: '-' | append: product.id
        -%}
        <li class="product-slider__item">
          <product-slider-card-{{ section_id }} class="product-slider__card">
            <div class="product-slider__media">
              <a href="{{ product.url }}" class="product-slider__media-link" tabindex="-1" aria-hidden="true">
                {%- if current_image != blank -%}
                  {{
                    current_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 900',
                      sizes: '(min-width: 750px) 25vw, 50vw',
                      alt: product.title,
                      data-card-image: ''
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>

              {%- if section.settings.show_badges -%}
                {%- liquid
                  assign show_badge = false
                  if current_variant.available == false or current_variant.compare_at_price > current_variant.price
                    assign show_badge = true
                  endif
                -%}
                <span class="product-slider__badge" data-card-badge {% unless show_badge %}hidden{% endunless %}>
                  {%- if current_variant.available == false -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- else -%}
                    {{ 'products.product.on_sale' | t }}
                  {%- endif -%}
                </span>
              {%- endif -%}

              <div class="product-slider__actions">
                {%- comment -%} Bundle builder products need shades chosen on their own page, so no quick add. {%- endcomment -%}
                {%- if section.settings.show_quick_add and single_option and product.template_suffix == blank -%}
                  <product-form data-hide-errors="true">
                    {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id" data-card-variant-input>
                      <button
                        type="submit"
                        name="add"
                        class="product-slider__action"
                        aria-label="{{ 'products.product.add_to_cart' | t }}"
                        data-card-add
                        {% unless current_variant.available %}
                          disabled
                        {% endunless %}
                      >
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                          <path d="M5 6.5h10l-.8 10.2a1 1 0 0 1-1 .8H6.8a1 1 0 0 1-1-.8L5 6.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                          <path d="M7.5 8.5V5.5a2.5 2.5 0 0 1 5 0v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                        </svg>
                        {%- render 'loading-spinner' -%}
                      </button>
                    {%- endform -%}
                  </product-form>
                {%- endif -%}
                {%- if section.settings.show_wishlist -%}
                  <button
                    type="button"
                    class="product-slider__action"
                    aria-label="Add {{ product.title | escape }} to wishlist"
                    aria-pressed="false"
                    data-wishlist-toggle
                    data-product-handle="{{ product.handle }}"
                    data-wishlist-url="{{ section.settings.wishlist_page.url | default: '/pages/wishlist' }}"
                    data-added-text="Added to wishlist"
                    data-removed-text="Removed from wishlist"
                    data-view-text="View wishlist"
                  >
                    <svg class="wishlist-heart" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                      <path d="M10 16.8s-6.5-3.9-6.5-8.6A3.6 3.6 0 0 1 10 6.1a3.6 3.6 0 0 1 6.5 2.1c0 4.7-6.5 8.6-6.5 8.6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {%- endif -%}
                <a href="{{ product.url }}" class="product-slider__action" aria-label="{{ product.title | escape }}">
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                    <path d="M1.5 10S4.5 4.5 10 4.5 18.5 10 18.5 10 15.5 15.5 10 15.5 1.5 10 1.5 10Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    <circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.4"/>
                  </svg>
                </a>
              </div>
            </div>

            <div class="product-slider__info">
              <a href="{{ product.url }}" class="product-slider__title">{{ product.title | escape }}</a>
              <div class="product-slider__price" data-card-price>
                {{- current_variant.price | money -}}
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  <s>{{ current_variant.compare_at_price | money }}</s>
                {%- endif -%}
              </div>

              {%- if show_shades -%}
                <div class="product-slider__shades">
                  {%- for variant in product.variants -%}
                    {%- if forloop.index == shade_limit and product.variants.size > shade_limit -%}
                      <button type="button" class="product-slider__shade-more" data-card-more>
                        +{{ product.variants.size | minus: shade_limit | plus: 1 }}
                      </button>
                      <span class="product-slider__shade-extra" hidden>
                    {%- endif -%}
                    {%- assign swatch_image = variant.featured_image | default: product.featured_image -%}
                    <button
                      type="button"
                      class="product-slider__shade{% if variant.id == current_variant.id %} is-selected{% endif %}"
                      style="background-image: url('{{ swatch_image | image_url: width: 80 }}');"
                      data-variant-id="{{ variant.id }}"
                      aria-label="{{ variant.title | escape }}"
                      title="{{ variant.title | escape }}"
                      {% unless variant.available %}
                        data-sold-out="true"
                      {% endunless %}
                    ></button>
                    {%- if forloop.last and product.variants.size > shade_limit -%}
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="product-slider__shade-name" data-card-shade-name>{{ current_variant.title | escape }}</p>

                <script type="application/json" data-card-variants>
                  {%- liquid
                    assign shade_media_ids = product.variants | map: "featured_media" | map: "id" | join: ","
                    assign shade_media_ids = "," | append: shade_media_ids | append: ","
                  -%}
                  [
                    {%- for variant in product.variants -%}
                      {%- liquid
                        assign variant_image = variant.featured_image | default: product.featured_image
                        if section.settings.shade_photo == "second" and variant.featured_media
                          assign next_media = product.media[variant.featured_media.position]
                          if next_media and next_media.media_type == "image"
                            assign next_media_key = "," | append: next_media.id | append: ","
                            unless shade_media_ids contains next_media_key
                              assign variant_image = next_media.preview_image
                            endunless
                          endif
                        endif
                        assign compare_at = null
                        if variant.compare_at_price > variant.price
                          assign compare_at = variant.compare_at_price | money
                        endif
                      -%}
                      {
                        "id": {{ variant.id | json }},
                        "name": {{ variant.title | json }},
                        "available": {{ variant.available | json }},
                        "price": {{ variant.price | money | json }},
                        "compareAtPrice": {{ compare_at | json }},
                        "image": {{ variant_image | image_url: width: 900 | json }}
                      }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                </script>
              {%- endif -%}
            </div>
          </product-slider-card-{{ section_id }}>
        </li>
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="product-slider__item">
            <div class="product-slider__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-slider__info">
              <span class="product-slider__title">{{ 'onboarding.product_title' | t }}</span>
            </div>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>

    <div class="product-slider__nav" data-slider-nav>
      <button
        type="button"
        class="product-slider__arrow"
        data-slider-prev
        aria-label="{{ 'general.slider.previous_slide' | t }}"
        aria-controls="ProductSlider-{{ section_id }}"
      >
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
          <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        type="button"
        class="product-slider__arrow"
        data-slider-next
        aria-label="{{ 'general.slider.next_slide' | t }}"
        aria-controls="ProductSlider-{{ section_id }}"
      >
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
          <path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.product-slider-{{ section_id }}');
    if (!root) return;

    var track = root.querySelector('.product-slider__track');
    var nav = root.querySelector('[data-slider-nav]');
    var prev = root.querySelector('[data-slider-prev]');
    var next = root.querySelector('[data-slider-next]');

    function step() {
      var item = track.querySelector('.product-slider__item');
      if (!item) return track.clientWidth;
      return item.getBoundingClientRect().width + (parseFloat(getComputedStyle(track).columnGap) || 0);
    }

    function update() {
      var maxScroll = track.scrollWidth - track.clientWidth;
      nav.hidden = maxScroll <= 1;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= maxScroll - 1;
    }

    prev.addEventListener('click', function () {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    next.addEventListener('click', function () {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    var tagName = 'product-slider-card-{{ section_id }}';
    if (customElements.get(tagName)) return;

    customElements.define(
      tagName,
      class extends HTMLElement {
        connectedCallback() {
          var dataEl = this.querySelector('[data-card-variants]');
          if (!dataEl) return;
          this.variants = JSON.parse(dataEl.textContent);

          this.querySelectorAll('.product-slider__shade').forEach((button) => {
            button.addEventListener('click', () => this.select(button));
          });

          var more = this.querySelector('[data-card-more]');
          if (more) {
            more.addEventListener('click', () => {
              this.querySelector('.product-slider__shade-extra').hidden = false;
              more.remove();
            });
          }
        }

        select(button) {
          var id = Number(button.dataset.variantId);
          var variant = this.variants.find((v) => v.id === id);
          if (!variant) return;

          this.querySelectorAll('.product-slider__shade').forEach((el) => el.classList.toggle('is-selected', el === button));

          var input = this.querySelector('[data-card-variant-input]');
          if (input) input.value = variant.id;

          var add = this.querySelector('[data-card-add]');
          if (add) add.disabled = !variant.available;

          var image = this.querySelector('[data-card-image]');
          if (image && variant.image) {
            image.removeAttribute('srcset');
            image.src = variant.image;
          }

          var price = this.querySelector('[data-card-price]');
          if (price) {
            price.textContent = variant.price;
            if (variant.compareAtPrice) {
              var s = document.createElement('s');
              s.textContent = variant.compareAtPrice;
              price.appendChild(s);
            }
          }

          var name = this.querySelector('[data-card-shade-name]');
          if (name) name.textContent = variant.name;

          var badge = this.querySelector('[data-card-badge]');
          if (badge) {
            if (!variant.available) {
              badge.textContent = {{ 'products.product.sold_out' | t | json }};
              badge.hidden = false;
            } else if (variant.compareAtPrice) {
              badge.textContent = {{ 'products.product.on_sale' | t | json }};
              badge.hidden = false;
            } else {
              badge.hidden = true;
            }
          }
        }
      }
    );
  })();
</script>

{% schema %}
{
  "name": "Product slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Lip glosses"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Uses the collection page when empty."
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "portrait", "label": "Tall (3:4)" },
        { "value": "tall", "label": "Slightly tall (4:5)" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
