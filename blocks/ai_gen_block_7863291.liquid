    {
      "type": "header",
      "content": "Menu 2"
    },
    {
      "type": "checkbox",
      "id": "menu_2_enabled",
      "label": "Enable menu 2",
      "default": true
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Heading",
      "default": "Returns and exchanges"
    },
    {
      "type": "richtext",
      "id": "menu_2_content",
      "label": "Content",
      "default": "<p>We accept returns within 30 days of purchase. Items must be unworn and in original condition.</p>"
    },
    {
      "type": "header",
      "content": "Menu 3"
    },
    {
      "type": "checkbox",
      "id": "menu_3_enabled",
      "label": "Enable menu 3",
      "default": true
    },
    {
      "type": "text",
      "id": "menu_3_heading",
      "label": "Heading",
