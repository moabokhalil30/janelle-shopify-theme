{% doc %}
  @prompt
    footer image

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-image-{{ ai_gen_id }} {
    width: 100%;
    margin: {{ block.settings.margin_top }}px0 {{ block.settings.margin_bottom }}px;
  }

  .ai-footer-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.alignment }};
  }

  .ai-footer-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: inline-block;
    width: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-footer-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;opacity: {{ block.settings.opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-footer-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border-radius: {{ block.settings.border_radius }}px;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-footer-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-footer-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-footer-image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-footer-image-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: {{ block.settings.text_color }};
    z-index: 2;
    width: 90%;
  }

  .ai-footer-image-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .ai-footer-image-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    opacity: 0.9;
    line-height: 1.4;
  }

  {% if block.settings.enable_link and block.settings.image_link != blank %}
    .ai-footer-image-wrapper-{{ ai_gen_id }} {
      cursor: pointer;
    }

    .ai-footer-image-wrapper-{{ ai_gen_id }}:hover img {
      opacity: {{ block.settings.hover_opacity | divided_by: 100.0 }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-footer-image-{{ ai_gen_id }} {
      margin: {{ block.settings.margin_top | times: 0.7 }}px 0 {{ block.settings.margin_bottom | times: 0.7 }}px;
    }

    .ai-footer-image-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-footer-image-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }
{% endstyle %}<div class="ai-footer-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-image-container-{{ ai_gen_id }}">
    {% if block.settings.enable_link and block.settings.image_link != blank %}
      <a href="{{ block.settings.image_link }}" class="ai-footer-image-wrapper-{{ ai_gen_id }}">
    {% else %}
      <div class="ai-footer-image-wrapper-{{ ai_gen_id }}">
    {% endif %}

    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000}}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}">
      {% if block.settings.enable_overlay %}
        <div class="ai-footer-image-overlay-{{ ai_gen_id }}"></div>
      {% endif %}

      {% if block.settings.title != blank or block.settings.subtitle != blank %}
        <div class="ai-footer-image-content-{{ ai_gen_id }}">
          {% if block.settings.title != blank %}
            <h3 class="ai-footer-image-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.subtitle != blank %}
            <p class="ai-footer-image-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% else %}
      <div class="ai-footer-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-footer-image-empty-state-{{ ai_gen_id }}">
          Add a footer image
        </div>
      </div>
    {% endif %}

    {% if block.settings.enable_link and block.settings.image_link != blank %}
      </a>
    {% else %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Footer image",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 200,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 800
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text overlay"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 24
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image effects"
    },
    {
      "type": "range",
      "id": "opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image opacity",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "checkbox",
      "id": "enable_link",
      "label": "Make image clickable",
      "default": false
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
    },
    {
      "type": "range",
      "id": "hover_opacity",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Hover opacity",
      "default": 80
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Footer image"
    }
  ]
}
{% endschema %}