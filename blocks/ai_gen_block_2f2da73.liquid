{% doc %}
  @prompt
    generate a block that have image that can be resizable on the left and title and body on the right with small form has name and input area, email and input area and message to leave and text area and a submit button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-contact-form-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: stretch;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-contact-form-image-column-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
    max-width: {{ block.settings.image_width }}%;
  }

  .ai-contact-form-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-contact-form-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-contact-form-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-contact-form-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-contact-form-content-column-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-contact-form-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-contact-form-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px 0;
    font-weight: 600;
  }

  .ai-contact-form-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-contact-form-contact-info-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    margin: 12px 0 0 0;
  }

  .ai-contact-form-contact-info-{{ ai_gen_id }} a {
    color: {{ block.settings.title_color }};
    font-weight: 600;
    text-decoration: underline;
  }

  .ai-contact-form-form-wrapper-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.field_spacing }}px;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    margin-bottom: 8px;
    font-weight: 500;
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    font-size: {{ block.settings.input_size }}px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_bg_color }};
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-family: inherit;
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: {{ block.settings.textarea_height }}px;
    resize: vertical;
  }

  .ai-contact-form-submit-{{ ai_gen_id }} {
    padding: 14px 32px;
    font-size: {{ block.settings.button_size }}px;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_bg_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-contact-form-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-contact-form-message-{{ ai_gen_id }} {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
  }

  .ai-contact-form-success-{{ ai_gen_id }} {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .ai-contact-form-error-{{ ai_gen_id }} {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-contact-form-image-column-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-contact-form-image-placeholder-{{ ai_gen_id }} {
      min-height: 250px;
    }

    .ai-contact-form-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-contact-form-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_size }}px * 0.9);
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }} class="ai-contact-form-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-form-wrapper-{{ ai_gen_id }}">
    <div class="ai-contact-form-image-column-{{ ai_gen_id }}">
      <div class="ai-contact-form-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-contact-form-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-contact-form-content-column-{{ ai_gen_id }}">
      <div class="ai-contact-form-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-contact-form-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.body != blank %}
          <div class="ai-contact-form-body-{{ ai_gen_id }}">{{ block.settings.body }}</div>
        {% endif %}
        {% if block.settings.show_contact_email and block.settings.contact_email != blank %}
          <p class="ai-contact-form-contact-info-{{ ai_gen_id }}">
            {{ block.settings.contact_email_intro }}
            <a href="mailto:{{ block.settings.contact_email }}">{{ block.settings.contact_email }}</a>
          </p>
        {% endif %}
      </div>

      <div class="ai-contact-form-form-wrapper-{{ ai_gen_id }}">
        {%- form 'contact' -%}
          {% if form.posted_successfully? %}
            <div class="ai-contact-form-message-{{ ai_gen_id }} ai-contact-form-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="ai-contact-form-message-{{ ai_gen_id }} ai-contact-form-error-{{ ai_gen_id }}">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label for="contact-name-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
              {{ block.settings.name_label }}
            </label>
            <input
              type="text"
              id="contact-name-{{ ai_gen_id }}"
              name="contact[name]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              value="{% if form.name %}{{ form.name }}{% endif %}"
              placeholder="{{ block.settings.name_placeholder }}"
              required
            >
          </div>

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label for="contact-email-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
              {{ block.settings.email_label }}
            </label>
            <input
              type="email"
              id="contact-email-{{ ai_gen_id }}"
              name="contact[email]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              value="{% if form.email %}{{ form.email }}{% endif %}"
              placeholder="{{ block.settings.email_placeholder }}"
              autocomplete="email"
              required
            >
          </div>

          {% if block.settings.show_phone_field %}
            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label for="contact-phone-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
                {{ block.settings.phone_label }}
              </label>
              <input
                type="tel"
                id="contact-phone-{{ ai_gen_id }}"
                name="contact[Phone]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                value="{% if form.phone %}{{ form.phone }}{% endif %}"
                placeholder="{{ block.settings.phone_placeholder }}"
                autocomplete="tel"
              >
            </div>
          {% endif %}

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label for="contact-message-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">
              {{ block.settings.message_label }}
            </label>
            <textarea
              id="contact-message-{{ ai_gen_id }}"
              name="contact[body]"
              class="ai-contact-form-textarea-{{ ai_gen_id }}"
              placeholder="{{ block.settings.message_placeholder }}"
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <button type="submit" class="ai-contact-form-submit-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form) {
          form.addEventListener('submit', function() {
            const submitButton = form.querySelector('.ai-contact-form-submit-{{ ai_gen_id }}');
            if (submitButton) {
              submitButton.disabled = true;
              submitButton.textContent = 'Sending...';
            }
          });
        }
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>

