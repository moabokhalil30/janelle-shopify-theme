{% doc %}
  @prompt
    Create a customizable image block for the footer section that allows merchants to upload and display images in their footer. Include options to adjust image size, alignment, and add alt text for accessibility.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-image-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-footer-image-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    width: 100%;
    display: block;
  }

  .ai-footer-image-img-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.border_radius }}px;
    opacity: {{ block.settings.opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-footer-image-img-{{ ai_gen_id }}:hover {
    opacity: {{ block.settings.hover_opacity | divided_by: 100.0 }};
  }

  .ai-footer-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-footer-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 120px;
    opacity: 0.3;
  }

  .ai-footer-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-footer-image-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-image-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_alignment }};
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_horizontal }}px {{ block.settings.mobile_padding_bottom }}px {{ block.settings.mobile_padding_horizontal }}px;
    }

    .ai-footer-image-container-{{ ai_gen_id }} {
      max-width: {{ block.settings.mobile_max_width }}px;
    }
  }
{% endstyle %}

<div class="ai-footer-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image %}
    {% if block.settings.link != blank %}
      <a href="{{ block.settings.link }}" class="ai-footer-image-link-{{ ai_gen_id }}">
    {% endif %}
    <div class="ai-footer-image-container-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.image | image_url: width: 800}}"
        alt="{{ block.settings.alt_text | default: block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-footer-image-img-{{ ai_gen_id }}"
      ></div>
    
    {% if block.settings.link != blank %}
      </a>
    {% endif %}
  {% else %}
    <div class="ai-footer-image-container-{{ ai_gen_id }}">
      <div class="ai-footer-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-footer-image-empty-state-{{ ai_gen_id }}">
          Add an image for your footer
        </div>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Footer image",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt text",
      "info": "Describe the image for screen readers. Leave blank to use the image's alt text."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Maximum width",
      "default": 200
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "mobile_max_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Mobile maximum width",
      "default": 150
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_horizontal",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Mobile horizontal padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacity",
      "default": 100
    },
    {
      "type": "range",
      "id": "hover_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Hover opacity",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Footer image"
    }
  ],
  "tag": null
}
{% endschema %}