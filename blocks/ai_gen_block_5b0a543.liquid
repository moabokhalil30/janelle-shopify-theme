{% doc %}
  @prompt
     i want 8 dynamic boxes ( whethaer i want to show it or not ) for 8 different categories with title and peices and button for each one as 1 box and text beside it and the other box is under the text and the text is under the box like this with image selector with boarder radius and adjusting spaces between text , make the text and button in the center and there is a sale tag (dynamic ) with the before and after price , i want the background of the section customizable and the font of the section is times new roman , the image section must be stick to it's size " all images are the same size", the button i want border to it 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
    font-family: 'Times New Roman', Times, serif;
  }

  .ai-category-showcase__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-category-showcase__item-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.item_gap }}px;
    align-items: center;
    margin-bottom: {{ block.settings.item_spacing }}px;
  }

  .ai-category-showcase__item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-category-showcase__item--reverse-{{ ai_gen_id }} {
    direction: rtl;
  }

  .ai-category-showcase__item--reverse-{{ ai_gen_id }} > * {
    direction: ltr;
  }

  .ai-category-showcase__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-category-showcase__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-category-showcase__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-showcase__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-showcase__sale-tag-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.sale_tag_position }}px;
    right: {{ block.settings.sale_tag_position }}px;
    background-color: {{ block.settings.sale_tag_bg_color }};
    color: {{ block.settings.sale_tag_text_color }};
    padding: 8px 16px;
    border-radius: {{ block.settings.sale_tag_radius }}px;
    font-size: {{ block.settings.sale_tag_font_size }}px;
    font-weight: bold;
    z-index: 2;
  }

  .ai-category-showcase__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-category-showcase__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: bold;
  }

  .ai-category-showcase__price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .ai-category-showcase__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: bold;
  }

  .ai-category-showcase__compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_font_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-category-showcase__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    cursor: pointer;
  }

  .ai-category-showcase__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }
  
   .ai-category-showcase__link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  @media screen and (max-width: 768px) {
    .ai-category-showcase__item-{{ ai_gen_id }},
    .ai-category-showcase__item--reverse-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      direction: ltr;
    }

    .ai-category-showcase__item--reverse-{{ ai_gen_id }} > * {
      direction: ltr;
    }
  }
{% endstyle %}

<div class="ai-category-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-showcase__container-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign enabled_key = 'category_' | append: i | append: '_enabled'
        assign image_key = 'category_' | append: i | append: '_image'
        assign title_key = 'category_' | append: i | append: '_title'
        assign price_key = 'category_' | append: i | append: '_price'
        assign compare_price_key = 'category_' | append: i | append: '_compare_price'
        assign button_text_key = 'category_' | append: i | append: '_button_text'
        assign button_link_key = 'category_' | append: i | append: '_button_link'
        assign show_sale_key = 'category_' | append: i | append: '_show_sale'
        assign sale_text_key = 'category_' | append: i | append: '_sale_text'

        assign enabled = block.settings[enabled_key]
        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign price = block.settings[price_key]
        assign compare_price = block.settings[compare_price_key]
        assign button_text = block.settings[button_text_key]
        assign button_link = block.settings[button_link_key]
        assign show_sale = block.settings[show_sale_key]
        assign sale_text = block.settings[sale_text_key]

        assign is_reverse = i | modulo: 2
      %}

      {% if enabled %}
        <div class="ai-category-showcase__item-{{ ai_gen_id }} {% if is_reverse == 0 %}ai-category-showcase__item--reverse-{{ ai_gen_id }}{% endif %}">
         {% if button_link != blank %}
            <a href="{{ button_link }}" class="ai-category-showcase__link-{{ ai_gen_id }}" aria-label="{{ title | escape }}">
          {% endif %}
          <div class="ai-category-showcase__image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                class="ai-category-showcase__image-{{ ai_gen_id }}"
                loading="lazy"
                width="800"
                height="800"
              >
            {% else %}
              <div class="ai-category-showcase__placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if show_sale and sale_text != blank %}
              <div class="ai-category-showcase__sale-tag-{{ ai_gen_id }}">
                {{ sale_text }}
              </div>
            {% endif %}
          </div>
           {% if button_link != blank %}
            </a>
          {% endif %}

          <div class="ai-category-showcase__content-{{ ai_gen_id }}">
            {% if title != blank %}
               {% if button_link != blank %}
                <a href="{{ button_link }}" class="ai-category-showcase__link-{{ ai_gen_id }}">
                  <h3 class="ai-category-showcase__title-{{ ai_gen_id }}">{{ title }}</h3>
                </a>
              {% else %}
                <h3 class="ai-category-showcase__title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
            {% endif %}

            <div class="ai-category-showcase__price-wrapper-{{ ai_gen_id }}">
              {% if price != blank %}
                <span class="ai-category-showcase__price-{{ ai_gen_id }}">{{ price }}</span>
              {% endif %}
              {% if compare_price != blank %}
                <span class="ai-category-showcase__compare-price-{{ ai_gen_id }}">{{ compare_price }}</span>
              {% endif %}
            </div>

            {% if button_text != blank %}
              <a
                href="{{ button_link }}"
                class="ai-category-showcase__button-{{ ai_gen_id }}"
              >
                {{ button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

