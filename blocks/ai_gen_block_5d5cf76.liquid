{% doc %}
  @prompt
    2 drop down text list and a picture section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dropdown-image-section-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    flex-wrap: wrap;
  }

  .ai-dropdown-image-section__content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 300px;
  }

  .ai-dropdown-image-section__image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 300px;
  }

  .ai-dropdown-image-section__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .ai-dropdown-image-section__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-dropdown-image-section__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-dropdown-image-section__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-dropdown-item-{{ ai_gen_id }} {
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.dropdown_border_radius }}px;
    margin-bottom: {{ block.settings.dropdown_spacing }}px;
    overflow: hidden;
  }

  .ai-dropdown-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-dropdown-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.dropdown_padding }}px;
    background-color: {{ block.settings.header_background_color }};
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-dropdown-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.header_hover_color }};
  }

  .ai-dropdown-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
  }

  .ai-dropdown-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
    flex-shrink: 0;
  }

  .ai-dropdown-icon-{{ ai_gen_id }}.active {
    transform: rotate(180deg);
  }

  .ai-dropdown-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-dropdown-content-{{ ai_gen_id }}.active {
    max-height: 1000px;
  }

  .ai-dropdown-text-{{ ai_gen_id }} {
    padding: {{ block.settings.dropdown_padding }}px;
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    background-color: {{ block.settings.content_background_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-dropdown-image-section-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-dropdown-image-section__content-{{ ai_gen_id }},
    .ai-dropdown-image-section__image-wrapper-{{ ai_gen_id }} {
      min-width: 100%;
    }
  }
{% endstyle %}

<dropdown-section-{{ ai_gen_id }} class="ai-dropdown-image-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dropdown-image-section__content-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% liquid
        assign title_key = 'dropdown_' | append: i | append: '_title'
        assign content_key = 'dropdown_' | append: i | append: '_content'
        assign title = block.settings[title_key]
        assign content = block.settings[content_key]
      %}

      <div class="ai-dropdown-item-{{ ai_gen_id }}" data-dropdown="{{ i }}">
        <div class="ai-dropdown-header-{{ ai_gen_id }}" role="button" aria-expanded="false" tabindex="0">
          <h3 class="ai-dropdown-title-{{ ai_gen_id }}">{{ title }}</h3>
          <svg class="ai-dropdown-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
        <div class="ai-dropdown-content-{{ ai_gen_id }}">
          <div class="ai-dropdown-text-{{ ai_gen_id }}">
            {{ content }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="ai-dropdown-image-section__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 1000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-dropdown-image-section__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-dropdown-image-section__image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-dropdown-image-section__empty-state-{{ ai_gen_id }}">
          Next, add an image
        </div>
      </div>
    {% endif %}
  </div>
</dropdown-section-{{ ai_gen_id }}>

<script>
  (function() {
    class DropdownSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.dropdowns = this.querySelectorAll('.ai-dropdown-item-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.dropdowns.forEach((dropdown) => {
          const header = dropdown.querySelector('.ai-dropdown-header-{{ ai_gen_id }}');
          const content = dropdown.querySelector('.ai-dropdown-content-{{ ai_gen_id }}');
          const icon = dropdown.querySelector('.ai-dropdown-icon-{{ ai_gen_id }}');

          const toggleDropdown = () => {
            const isActive = content.classList.contains('active');
            
            content.classList.toggle('active');
            icon.classList.toggle('active');
            header.setAttribute('aria-expanded', !isActive);
          };

          header.addEventListener('click', toggleDropdown);
          
          header.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              toggleDropdown();
            }
          });
        });
      }
    }

    customElements.define('dropdown-section-{{ ai_gen_id }}', DropdownSection{{ ai_gen_id }});
  })();
</script>

