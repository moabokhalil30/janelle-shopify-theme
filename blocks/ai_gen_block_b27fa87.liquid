{% doc %}
  @prompt
    i want 2 counters one for clients and one for total orders (Dynamic )
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-stats-counter-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-stats-counter__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-stats-counter__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-stats-counter__item-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }

  .ai-stats-counter__number-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: {{ block.settings.number_weight }};
    color: {{ block.settings.number_color }};
    margin: 0 0 {{ block.settings.number_margin }}px;
    line-height: 1.2;
  }

  .ai-stats-counter__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-stats-counter__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_margin }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-stats-counter__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-stats-counter__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap | times: 0.8 }}px;
    }

    .ai-stats-counter__number-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.8 }}px;
    }

    .ai-stats-counter__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<stats-counter-{{ ai_gen_id }}
  class="ai-stats-counter-{{ ai_gen_id }}"
  data-duration="{{ block.settings.animation_duration }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-stats-counter__container-{{ ai_gen_id }}">
    <div class="ai-stats-counter__grid-{{ ai_gen_id }}">
      <div class="ai-stats-counter__item-{{ ai_gen_id }}">
        {% if block.settings.show_icons %}
          <div class="ai-stats-counter__icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
        {% endif %}
        <div
          class="ai-stats-counter__number-{{ ai_gen_id }}"
          data-target="{{ block.settings.clients_count }}"
          data-counter="clients"
        >
          0
        </div>
        <p class="ai-stats-counter__label-{{ ai_gen_id }}">{{ block.settings.clients_label }}</p>
      </div>

      <div class="ai-stats-counter__item-{{ ai_gen_id }}">
        {% if block.settings.show_icons %}
          <div class="ai-stats-counter__icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
          </div>
        {% endif %}
        <div
          class="ai-stats-counter__number-{{ ai_gen_id }}"
          data-target="{{ block.settings.orders_count }}"
          data-counter="orders"
        >
          0
        </div>
        <p class="ai-stats-counter__label-{{ ai_gen_id }}">{{ block.settings.orders_label }}</p>
      </div>
    </div>
  </div>
</stats-counter-{{ ai_gen_id }}>

<script>
  (function() {
    class StatsCounter{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.animated = false;
      }

      connectedCallback() {
        this.duration = parseInt(this.dataset.duration) || 2000;
        this.counters = this.querySelectorAll('[data-counter]');
        
        if ('IntersectionObserver' in window) {
          this.observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting && !this.animated) {
                  this.animateCounters();
                  this.animated = true;
                }
              });
            },
            { threshold: 0.5 }
          );
          this.observer.observe(this);
        } else {
          this.animateCounters();
        }
      }

      animateCounters() {
        this.counters.forEach((counter) => {
          const target = parseInt(counter.dataset.target) || 0;
          const startTime = performance.now();
          
          const updateCounter = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / this.duration, 1);
            
            const easeOutQuart = 1 - Math.pow(1 - progress, 4);
            const current = Math.floor(easeOutQuart * target);
            
            counter.textContent = this.formatNumber(current);
            
            if (progress < 1) {
              requestAnimationFrame(updateCounter);
            } else {
              counter.textContent = this.formatNumber(target);
            }
          };
          
          requestAnimationFrame(updateCounter);
        });
      }

      formatNumber(num) {
        return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('stats-counter-{{ ai_gen_id }}', StatsCounter{{ ai_gen_id }});
  })();
</script>

