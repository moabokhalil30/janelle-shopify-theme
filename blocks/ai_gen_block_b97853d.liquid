{% doc %}
  @prompt
    I WANT 3 IMAGES THAT CAN BE RESIZABLE AND HAS BOARDER RADIUS THAT ALIGN HORIZONTALLY 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px;
  }

  .ai-image-gallery__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_spacing }}px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ai-image-gallery__item-{{ ai_gen_id }} {
    flex: 0 1 auto;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-gallery__item-{{ ai_gen_id }}--1 {
    width: {{ block.settings.image_1_width }}%;
    max-width: 100%;
  }

  .ai-image-gallery__item-{{ ai_gen_id }}--2 {
    width: {{ block.settings.image_2_width }}%;
    max-width: 100%;
  }

  .ai-image-gallery__item-{{ ai_gen_id }}--3 {
    width: {{ block.settings.image_3_width }}%;
    max-width: 100%;
  }

  .ai-image-gallery__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-gallery__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-gallery__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-image-gallery__container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-image-gallery__item-{{ ai_gen_id }}--1,
    .ai-image-gallery__item-{{ ai_gen_id }}--2,
    .ai-image-gallery__item-{{ ai_gen_id }}--3 {
      width: 100%;
    }
  }
{% endstyle %}

<image-gallery-{{ ai_gen_id }}
  class="ai-image-gallery-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-gallery__container-{{ ai_gen_id }}">
    <div class="ai-image-gallery__item-{{ ai_gen_id }} ai-image-gallery__item-{{ ai_gen_id }}--1">
      {% if block.settings.image_1 %}
        <img
          src="{{ block.settings.image_1 | image_url: width: 1200 }}"
          alt="{{ block.settings.image_1.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_1.width }}"
          height="{{ block.settings.image_1.height }}"
          class="ai-image-gallery__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-gallery__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-gallery__empty-state-{{ ai_gen_id }}">
            Add image 1
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-image-gallery__item-{{ ai_gen_id }} ai-image-gallery__item-{{ ai_gen_id }}--2">
      {% if block.settings.image_2 %}
        <img
          src="{{ block.settings.image_2 | image_url: width: 1200 }}"
          alt="{{ block.settings.image_2.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_2.width }}"
          height="{{ block.settings.image_2.height }}"
          class="ai-image-gallery__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-gallery__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-gallery__empty-state-{{ ai_gen_id }}">
            Add image 2
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-image-gallery__item-{{ ai_gen_id }} ai-image-gallery__item-{{ ai_gen_id }}--3">
      {% if block.settings.image_3 %}
        <img
          src="{{ block.settings.image_3 | image_url: width: 1200 }}"
          alt="{{ block.settings.image_3.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_3.width }}"
          height="{{ block.settings.image_3.height }}"
          class="ai-image-gallery__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-gallery__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-gallery__empty-state-{{ ai_gen_id }}">
            Add image 3
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</image-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('image-gallery-{{ ai_gen_id }}', ImageGallery{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image gallery",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_1_width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Desktop width",
      "default": 30
    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_2_width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Desktop width",
      "default": 30
    },
    {
      "type": "header",
      "content": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_3_width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Desktop width",
      "default": 30
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Spacing between images",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Image gallery"
    }
  ]
}
{% endschema %}
